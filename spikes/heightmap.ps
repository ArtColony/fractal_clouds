%!PS-Adobe-3.0
%%BoundingBox: 0 0 300 300
% Top-down view of the terrain height (fractal_clouds#1 diagnostics):
% x -600..600 across, z -300..900 up the page (the camera sits at 0,0
% looking up the page). Black = TerrBase, white = TerrTop. Red marks the
% camera, and the two lines its horizontal field of view.
/Seed where { pop } { /Seed 11 def } ifelse
(lib/fc_sky.ps) run
(lib/fc_noise2.ps) run (lib/fc_noise3.ps) run
(lib/fc_clouds.ps) run (lib/fc_terrain.ps) run (lib/fc_render.ps) run
Seed fc-noise2-init
/N 150 def /Row N string def /J 0 def
/lo 1e9 def /hi -1e9 def /sum 0 def
gsave 300 300 scale
N N 8 [N 0 0 N neg 0 N] {
  /zz 900 J 0.5 add N div 1200 mul sub def
  0 1 N 1 sub { /I exch def
    /xx I 0.5 add N div 1200 mul 600 sub def
    xx zz 5 fc-height
    dup lo lt { dup /lo exch def } if dup hi gt { dup /hi exch def } if dup sum add /sum exch def
    TerrBase sub TerrTop TerrBase sub div 255 mul cvi 0 fc-max 255 2 copy gt { exch } if pop
    Row I 3 -1 roll put } for
  /J J 1 add def Row } image
grestore
1 0 0 setrgbcolor 150 75 3 0 360 arc fill
0.6 setlinewidth 150 75 moveto -150 TanH mul 150 add 300 lineto stroke
150 75 moveto 150 TanH mul 150 add 300 lineto stroke
(heights: min ) print lo 24 string cvs print ( max ) print hi 24 string cvs print ( mean ) print sum N N mul div =
(at camera: ) print 0 0 TerrOct fc-height =
showpage
