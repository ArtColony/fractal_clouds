%!PS-Adobe-3.0
%%BoundingBox: 0 0 320 200
%%Title: Coast
% Status: draft
% fractal_clouds#39: a coast laid out on a map (lib/fc_map.ps) with a sea
% level (lib/fc_coast.ps): a mainland painted as a lift grid, cliffed along
% its western shore (a /cliff feature) and low to the east; a volcanic
% island with a fringing reef; a low atoll round its lagoon.
%   -D View=1    from a boat, the volcanic island (default)
%   -D View=2    from a boat, the western cliffs and a stack
%   -D Plan=true the map from above, both cameras marked
% Preview: DPI=36 scripts/render.sh spikes/coast.ps

/View where { pop } { /View 1 def } ifelse
/Plan where { pop } { /Plan false def } ifelse
/Seed where { pop } { /Seed 11 def } ifelse
/AA where { pop } { /AA true def } ifelse

% --- the map (x east, z north) ------------------------------------------------
/MapOn where { pop } { /MapOn true def } ifelse
/MapSea where { pop } { /MapSea 0 def } ifelse
/MapRect where { pop } { /MapRect [ -1000 -1000 1000 1000 ] def } ifelse
/MapBackground where { pop } { /MapBackground [ -20 0 ] def } ifelse       % open sea
/MapLiftRange where { pop } { /MapLiftRange [ -20 30 ] def } ifelse
/MapLiftGrid where { pop } { /MapLiftGrid [                % ground height, far (north) row first
    (          )
    (          )
    (          )
    (          )
    (          )
    (          )
    (%%%-      )
    (%%%%%=:.  )
    (%%%%%%%=-.)
    (%%%%%%%%%=)
] def } ifelse
/MapFeatures where { pop } { /MapFeatures [
    [ /volcano 70 330  150 450 ]                                 % the island
    [ /atoll  1.5 110 26  -560 360 ]                             % ring height, radius, width
    [ /cliff  20 200  -1000 -260  -560 -300  -300 -420  -120 -620 ]  % the sea cut the west back
    [ /stack  16 9  -480 -235 ]
] def } ifelse
/CoastReef where { pop } { /CoastReef [ 70 50 0.5 ] def } ifelse
/MapPlanN where { pop } { /MapPlanN 240 def } ifelse

% --- the viewpoints: x z yaw fov ---------------------------------------------
/Views [ [ -60 -20 8 64 ] [ -560 -140 172 56 ] ] def
View 2 eq {
    /TerrOX where { pop } { /TerrOX -560 def } ifelse
    /TerrOZ where { pop } { /TerrOZ -140 def } ifelse
    /Yaw where { pop } { /Yaw 172 def } ifelse
    /HFov where { pop } { /HFov 56 def } ifelse
    /CamHeight where { pop } { /CamHeight 5 def } ifelse
} {
    /TerrOX where { pop } { /TerrOX -60 def } ifelse
    /TerrOZ where { pop } { /TerrOZ -20 def } ifelse
    /Yaw where { pop } { /Yaw 8 def } ifelse
    /HFov where { pop } { /HFov 64 def } ifelse
    /CamHeight where { pop } { /CamHeight 5 def } ifelse
} ifelse
/Pitch where { pop } { /Pitch 2 def } ifelse
/TMax where { pop } { /TMax 1400 def } ifelse
Plan { /Erode where { pop } { /Erode false def } ifelse } if

% --- light and air -------------------------------------------------------------
/SunDir where { pop } { /SunDir [ -0.55 0.42 0.45 ] def } ifelse      % afternoon, from the west
/CloudLo where { pop } { /CloudLo 70 def } ifelse
/CloudHi where { pop } { /CloudHi 95 def } ifelse
/CoverAmp where { pop } { /CoverAmp 0.34 def } ifelse
/Threshold where { pop } { /Threshold 0.60 def } ifelse
/HazeDist where { pop } { /HazeDist 1100 def } ifelse
/SnowLine where { pop } { /SnowLine 200 def } ifelse                   % no snow by the sea
/WaterCol where { pop } { /WaterCol [ 0.06 0.17 0.20 ] def } ifelse
/WaterClear where { pop } { /WaterClear 1.2 def } ifelse

(lib/fc_landscape.ps) run

Plan {
    320 200 fc-map-plan
    1 1 2 { /WkV exch def
        /HFov Views WkV 1 sub get 3 get def
        WkV 1 string cvs Views WkV 1 sub get aload pop pop fc-map-plan-camera
    } for
} { 320 200 fc-landscape } ifelse
showpage
