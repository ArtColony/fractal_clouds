%!PS-Adobe-3.0
%%BoundingBox: 0 0 320 200
%%Title: Charted range
% Status: draft
% fractal_clouds#13: a range laid out on a map (lib/fc_map.ps) and filled in
% by the fractals: a main ridge with two peaks, a spur, a river valley down
% to a lake, and lower hills on either side. One geography, three outputs:
%   -D View=1   from the lake's south shore, looking north at the twins (default)
%   -D View=2   from the eastern hills, looking across the valley
%   -D Plan=true the map from above, with both cameras marked
% Preview: DPI=36 scripts/render.sh gallery/charted_range.ps (about 2 min a view;
% 72 dpi about 8).

/View where { pop } { /View 1 def } ifelse
/Plan where { pop } { /Plan false def } ifelse
/Seed where { pop } { /Seed 7 def } ifelse
/AA where { pop } { /AA true def } ifelse

% --- the map (coordinates are the terrain's: x east, z north) ----------------
/MapOn where { pop } { /MapOn true def } ifelse
/MapRect where { pop } { /MapRect [ -800 -800 800 800 ] def } ifelse
/MapBackground where { pop } { /MapBackground [ 5 0.04 ] def } ifelse   % the plain: 5 units above the base floor
/MapNoise where { pop } { /MapNoise 0.25 def } ifelse               % low noise hills between the features
/MapPlanRect where { pop } { /MapPlanRect [ -800 -560 800 440 ] def } ifelse  % the plan fills the page
/MapPlanN where { pop } { /MapPlanN 320 def } ifelse
/MapFeatures where { pop } { /MapFeatures [
    [ /ridge  36 150  -600 220  -330 230  -170 180  0 150  190 185  360 230  620 200 ]  % the main ridge
    [ /peak   48 130  -170 180 ]                                      % West Twin
    [ /peak   44 120   190 185 ]                                      % East Twin
    [ /ridge  24  90   -90 120  -170 20  -230 -80 ]                   % a spur toward the lake
    [ /valley  3  50    60 120    90 60   50 0   20 -40 ]             % the river, col to lake
    [ /lake  -0.5 4 50  -150 -40  -30 -15  110 -30  180 -100  140 -190  0 -215  -130 -185  -190 -110 ]
    [ /ridge  24 140   400 20   560 -170  650 -400 ]                  % eastern hills
    [ /ridge  30 150  -500 40  -620 -150  -680 -450 ]                 % western hills
] def } ifelse

% --- the viewpoints: x z yaw, in map coordinates -----------------------------
/Views [ [ 0 -250 0 60 ] [ 430 0 -72 60 ] ] def      % and the field of view, for the plan
View 2 eq {
    /TerrOX where { pop } { /TerrOX 430 def } ifelse
    /TerrOZ where { pop } { /TerrOZ 0 def } ifelse
    /Yaw where { pop } { /Yaw -72 def } ifelse
    /Pitch where { pop } { /Pitch 2 def } ifelse
    /CamLift where { pop } { /CamLift 0.55 def } ifelse
    /TMax where { pop } { /TMax 1200 def } ifelse
} {
    /TerrOX where { pop } { /TerrOX 0 def } ifelse
    /TerrOZ where { pop } { /TerrOZ -250 def } ifelse
    /Yaw where { pop } { /Yaw 0 def } ifelse
    /Pitch where { pop } { /Pitch 3 def } ifelse
    /CamAbove where { pop } { /CamAbove 7 def } ifelse
} ifelse
/HFov where { pop } { /HFov 60 def } ifelse
Plan { /Erode where { pop } { /Erode false def } ifelse } if   % the plan is the procedural terrain

% --- light and air (world-fixed, so both views share them) --------------------
/SunDir where { pop } { /SunDir [ 0.60 0.45 0.30 ] def } ifelse   % morning, from the east
/CloudLo where { pop } { /CloudLo 60 def } ifelse
/CloudHi where { pop } { /CloudHi 88 def } ifelse
/CoverAmp where { pop } { /CoverAmp 0.38 def } ifelse
/Threshold where { pop } { /Threshold 0.57 def } ifelse
/HazeDist where { pop } { /HazeDist 900 def } ifelse
/SnowLine where { pop } { /SnowLine 27 def } ifelse
% the lake: water at the level the map gave it (lib/fc_water.ps, #28)
/MapWater where { pop } { /MapWater true def } ifelse
/WaterCol where { pop } { /WaterCol [ 0.10 0.15 0.16 ] def } ifelse    % sRGB, seen straight down

(lib/fc_landscape.ps) run

Plan {
    320 200 fc-map-plan
    1 1 2 { /WkV exch def
        /HFov Views WkV 1 sub get 3 get def
        WkV 1 string cvs Views WkV 1 sub get aload pop pop fc-map-plan-camera
    } for
} { 320 200 fc-landscape } ifelse
showpage
