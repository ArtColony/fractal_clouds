%!PS-Adobe-3.0
%%BoundingBox: 0 0 320 200
%%Title: Evening lake
% Status: draft
% fractal_clouds#11: the valley of gallery/alpine_forest.ps flooded into a
% lake, under a low evening sun. Settings, plus about thirty lines of hooks
% for the water (lib/fc_landscape.ps does the rest).
% Preview: DPI=36 scripts/render.sh gallery/evening_lake.ps.

/Seed where { pop } { /Seed 5 def } ifelse
/AA where { pop } { /AA true def } ifelse
/TreesOn where { pop } { /TreesOn true def } ifelse
/Pitch where { pop } { /Pitch 2 def } ifelse
/Yaw where { pop } { /Yaw -27 def } ifelse
/HFov where { pop } { /HFov 55 def } ifelse
/TerrOX where { pop } { /TerrOX 180 def /TerrOZ 400 def } ifelse
/CamAbove where { pop } { /CamAbove 5 def } ifelse
/SnowLine where { pop } { /SnowLine 25 def } ifelse
% evening: a low sun behind the camera, on the right, lighting the peaks
/SunDir where { pop } { /SunDir [ 0.50 0.13 -0.55 ] def } ifelse
/SunCol where { pop } { /SunCol [ 1.00 0.72 0.48 ] def } ifelse
/Zenith where { pop } { /Zenith [ 0.24 0.34 0.58 ] def } ifelse
/Horizon where { pop } { /Horizon [ 0.94 0.74 0.58 ] def } ifelse
/SkyAmb where { pop } { /SkyAmb [ 0.52 0.56 0.70 ] def } ifelse
/Exposure where { pop } { /Exposure 1.9 def } ifelse
/CloudLo where { pop } { /CloudLo 62 def /CloudHi 84 def } ifelse
/Threshold where { pop } { /Threshold 0.60 def } ifelse
/CoverAmp where { pop } { /CoverAmp 0.5 def } ifelse
/HazeDist where { pop } { /HazeDist 520 def } ifelse
% the lake: its surface this far above the ground under the camera
/WaterRise where { pop } { /WaterRise 1.4 def } ifelse
/Water where { pop } { /Water [ 0.10 0.15 0.16 ] def } ifelse    % sRGB, seen straight down

(lib/fc_landscape.ps) run

% the water level, from the terrain before erosion (the forest bake needs it)
Seed fc-noise2-init
/WaterY 0 0 TerrOct fc-height-proc WaterRise add def
% no trees on ground the lake covers, or on its very edge
/fc-dry-dens /fc-forest-dens load def
/fc-forest-dens {                                % x z h ny curv -> density height-scale
    2 index /WkH exch def
    fc-dry-dens exch WkH WaterY 0.3 add sub 0.8 div 0 fc-max 1 fc-min mul exch
} bind def
fc-landscape-setup
/Water [ Water { 2.2 exp } forall ] def

% --- water -------------------------------------------------------------------
% A plane at WaterY. Its reflection is the same scene seen from the camera
% mirrored through the plane, along the mirrored ray: march that from the
% water point onwards (MarchT0) with the default hit and surface.
/fc-dry-hit /fc-landscape-hit load def
/fc-dry-surface /fc-landscape-surface load def

/fc-landscape-hit {                              % -> t | -1
    fc-dry-hit /WkT exch def /WkWet false def
    My 0 lt {
        WaterY CamY sub My div /WkW exch def
        WkT 0 lt WkW WkT lt or { /WkWet true def /WkT WkW def } if
    } if
    WkT
} bind def

/fc-landscape-surface {                          % t -> r g b
    WkWet not { fc-dry-surface } {
        /WkW exch def
        /WkMx Mx def /WkMy My def /WkMz Mz def /WkCam CamY def
        % ripples: tilt the mirror a little, less where they'd be under a pixel
        Mx WkW mul 0.7 mul Mz WkW mul 1.9 mul fc-noise2 0.5 sub
        WkW PixAng mul 0.35 exch div 1 fc-min 0.03 mul mul /WkRip exch def
        /CamY WaterY 2 mul CamY sub def /My My neg def
        /Mx Mx WkRip add def
        /MarchT0 WkW def
        fc-dry-hit /WkT exch def
        /MarchT0 0.5 def
        WkT 0 gt {
            WkT fc-dry-surface
            % haze from the water to what it reflects
            /CamY WaterY def WkT WkW sub fc-haze /CamY WaterY 2 mul WkCam sub def
        } { /WkT TMax def Mx My Mz fc-landscape-sky } ifelse
        /WkB exch def /WkG exch def /WkR exch def
        WkT fc-clouds
        % Fresnel (Schlick): the lake mirrors more at grazing angles
        1 WkMy neg sub 5 exp 0.98 mul 0.02 add /WkF exch def
        /Mx WkMx def /My WkMy def /Mz WkMz def /CamY WkCam def
        Cr WkR Tr mul add WkF mul  Water 0 get SkyAmb 0 get mul 0.5 mul 1 WkF sub mul add
        Cg WkG Tr mul add WkF mul  Water 1 get SkyAmb 1 get mul 0.5 mul 1 WkF sub mul add
        Cb WkB Tr mul add WkF mul  Water 2 get SkyAmb 2 get mul 0.5 mul 1 WkF sub mul add
    } ifelse
} bind def

320 200 fc-landscape
showpage
