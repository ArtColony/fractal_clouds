%!PS-Adobe-3.0
% fc_ocean.ps -- the sea for fc_water.ps: swell under the wind chop, colour
% by depth, foam on crests and in the surf, wet sand and sun glitter
% (fractal_clouds#38).
%
% fc_water.ps loads this file last when /Ocean is true (so a piece also sets
% WaterY or WaterRise, which load fc_water.ps). It replaces two of
% fc_water's hooks and wraps three more:
%
%   fc-water-normal       swell (a sum of directional waves) plus the lake's
%                         ripples as the chop
%   fc-water-colour       turquoise over shallows, dark blue-green when deep
%   fc-water-shade        adds sun glitter and foam (crests, surf, swash)
%   fc-landscape-surface  wet sand: a mirror band just above the waterline
%   fc-terrain-material   sand on the beach and the sea bed
%
% Waves change the shading only: the hit is fc_water's flat plane. At the
% views the issue asks for (a camera 1-4 units up, water from ~10 units
% out) a swell of slope 0.1 and wavelength 12 stands about 0.2 units high;
% near the camera the view ray falls more steeply than any wave face, and
% farther out a crest would shift what it hides by under two pixels (see
% docs/techniques.html section 12, The sea).
%
% Only the sea is changed: rivers, and map lakes above the sea plane, keep
% fc_water's ripples and colour (and get no surf, wet sand or sand).
%
% Depth here is sea level minus the ground's height (SeaDepthOct octaves)
% straight under the surface point, not fc_water's depth along the ray.
%
% Names: this file keeps its temporaries under Oc*.

/SwellAmp 0.10 fc-default            % swell slope: rms as the old four waves of slopes 1, 0.75, 0.6, 0.45 of it
/SwellLen 12 fc-default              % longest swell wavelength, world units
/SwellSpread 40 fc-default           % degrees the longest components' headings spread around WindDir
/SwellWaves 16 fc-default            % number of swell components
/SwellRatio 0.83 fc-default          % each component's wavelength over the previous one's
/SwellFan 2 fc-default               % the shortest components spread this many times SwellSpread
/SwellTilt 0.5 fc-default            % slope ~ wavelength^SwellTilt: 0 all equal, higher favours the long
/SwellShoal 0.8 fc-default           % extra steepness in the surf zone
/SeaShallow [ 0.10 0.70 0.66 ] fc-colour   % the water's own colour over shallows, sRGB
/SeaDeep [ 0.03 0.11 0.13 ] fc-colour      % ... and over deep water
/SeaDepth 1.5 fc-default             % depth over which shallow turns deep (1/e), world units
/SeaDepthOct 5 fc-default            % terrain octaves for the depth
/FoamCol [ 0.90 0.92 0.93 ] fc-colour      % foam albedo, sRGB
/FoamCrest 0.85 fc-default           % swell height (-1..1) where crests start to foam; 1 or more: none
/FoamScale 1.2 fc-default            % 1 / foam lace size
/SurfDepth 0.35 fc-default           % water shallower than this breaks
/SurfSpacing 1.5 fc-default          % distance between breaker lines, world units
/SurfTrail 0.3 fc-default            % foam trail behind a breaker, as a fraction of the spacing
/SurfFoam 1 fc-default               % surf foam cover, 0..1
/WetSand 0.1 fc-default              % height above the water of the wet band; 0: none
/WetMirror 0.75 fc-default           % how mirror-like the wet band is, 0..1
/WetSlope [ 0.72 0.9 ] fc-default    % the band fades out on slopes steeper than this (the normal's y; #78)
/GlitterGain 1 fc-default            % sun glitter; 0: none
/GlitterRough 0.03 fc-default        % slope spread the waves don't resolve
/SandHeight 0.8 fc-default           % sand on the bed and up to this height above the water; 0: none
/SandCol [ 0.74 0.67 0.52 ] fc-colour      % sRGB

% the swell: SwellWaves directional sine waves, a short-crested sea rather
% than a few long-crested trains (#77: four waves, one of them carrying half
% the slope, printed evenly spaced stripes once the shorter ones had faded).
% Wavelengths fall geometrically from SwellLen by SwellRatio, each jittered
% so no two are near harmonics; headings spread around WindDir, by
% SwellSpread for the longest and up to SwellFan times that for the
% shortest, crowded toward the wind (about cos² spreading); phases, jitter
% and headings come from fixed low-discrepancy sequences, not rand, so the
% sea draws nothing from the piece's random stream. The slopes fall gently
% with the wavelength (SwellTilt), so that no one component dominates at any
% distance, and are scaled so their summed variance is the old four waves'
% (1² + 0.75² + 0.6² + 0.45²): the sea is as rough as before, the glitter as
% wide. Each entry:
%   [ kx kz  cos sin  slope  phase  lost-weight  height-weight  wavelength ]
% k is 360 / wavelength along the heading; the lost weights add up to the old
% four slopes' sum, so the far sea (all components faded) is as before; the
% height weights (slope times wavelength: the long waves make the crests)
% are scaled so the summed height has the old one's spread.
/OcWaves [
    0 1 SwellWaves 1 sub { /OcI exch def
        OcI 0.618034 mul 0.37 add dup floor sub /OcU exch def
        OcI 0.754878 mul 0.11 add dup floor sub /OcV exch def
        OcI 0.569840 mul 0.83 add dup floor sub 360 mul /OcPh exch def
        SwellRatio OcI exp OcV 0.5 sub 0.16 mul 1 add mul /OcLf exch def
        % heading: V spread to -1..1, squeezed toward 0 (more energy downwind)
        OcU 2 mul 1 sub dup abs sqrt mul
        SwellFan 1 sub OcI SwellWaves 1 sub 1 fc-max div mul 1 add mul
        SwellSpread mul WindDir add /OcDg exch def
        SwellLen OcLf mul /OcWv exch def
        [ OcDg cos 360 mul OcWv div  OcDg sin 360 mul OcWv div
          OcDg cos OcDg sin
          OcLf SwellTilt exp  OcPh  0 0  OcWv ]
    } for
] def
/OcSq 0 OcWaves { 4 get dup mul add } forall def
/OcSs 2.125 OcSq div sqrt def
/OcWsum 0 def /OcHq 0 def
OcWaves { /OcW exch def
    OcW 4 OcW 4 get OcSs mul put
    /OcWsum OcWsum OcW 4 get add def
    /OcHq OcHq OcW 4 get OcW 8 get mul dup mul add def
} forall
/OcLs 2.8 OcWsum div def
/OcHs 1.4578 OcHq sqrt div def           % sqrt(2 x 2.125): the old sum's spread
OcWaves { /OcW exch def
    OcW 6 OcW 4 get OcLs mul put
    OcW 7 OcW 4 get OcW 8 get mul OcHs mul 2.8 div put
} forall
/OcD 1000 def /OcH 0 def /OcLost 0 def

% --- the bed under the sea ------------------------------------------------------
% fc_water marches the ground under the plane to find the bed it shows
% through the water; past about six WaterClear of water it no longer shows,
% so the march stops there instead of running out to TMax under open sea
% (reflected rays climb, so they march as before). It needs WaterY: map
% lakes alone keep the full march.
% TMax is shortened for the march and put back: fc_landscape has no
% separate march bound yet (a MarchT1 there would be the cleaner hook).
% While OcSkyOnly is true (the wet sand's reflection) there is no ground.
/OcSkyOnly false def /OcSea false def
/OcDryPrev /fc-water-dry-hit load def
/fc-water-dry-hit {                              % -> t | -1
    OcSkyOnly { -1 } {
    WaterY null ne My 0 lt and { WaterY CamY lt } { false } ifelse {
        /OcTm TMax def
        WaterY CamY sub My div WaterClear 6 mul add TMax fc-min /TMax exch def
        OcDryPrev
        /TMax OcTm def
    } { OcDryPrev } ifelse
    } ifelse
} bind def

% --- waves ----------------------------------------------------------------------
/OcNormPrev /fc-water-normal load def
/fc-water-normal {                               % x z t -> nx ny nz
    OcSea not { OcNormPrev } { fc-ocean-normal } ifelse
} bind def
/fc-ocean-normal {                               % x z t -> nx ny nz
    /OcT exch def /OcZ exch def /OcX exch def
    % depth straight down
    AqLev OcX OcZ SeaDepthOct fc-height sub /OcD exch def
    % the pixel's footprint along the view (as the ripples measure it)
    OcT PixAng mul My abs 0.12 fc-max div /OcFp exch def
    % the swell steepens as it comes into the surf
    SurfDepth 3 mul 0 OcD fc-smooth SwellShoal mul 1 add SwellAmp mul /OcA exch def
    /OcGx 0 def /OcGz 0 def /OcH 0 def /OcLost 0 def
    OcWaves { /OcW exch def
        OcW 8 get OcFp 3 mul div 1 fc-min /OcFd exch def
        OcFd 0.05 gt {
            OcX OcW 0 get mul OcZ OcW 1 get mul add OcW 5 get add /OcP exch def
            OcA OcW 4 get mul OcFd mul OcP cos mul /OcS exch def
            /OcGx OcGx OcS OcW 2 get mul add def
            /OcGz OcGz OcS OcW 3 get mul add def
            /OcH OcH OcP sin OcW 7 get mul OcFd mul add def
        } if
        /OcLost OcLost OcA OcW 6 get mul 1 OcFd sub mul add def
    } forall
    % the chop: the lake's ripples
    OcX OcZ OcT OcNormPrev
    /OcNz exch def /OcNy exch def /OcNx exch def
    % add the slopes; the swell's lost slope tilts toward the camera, as the
    % ripples' does
    /OcHn Mx Mx mul Mz Mz mul add sqrt 0.000001 fc-max def
    OcNx OcNy div neg OcGx add OcLost 0.5 mul Mx OcHn div mul add /OcGx exch def
    OcNz OcNy div neg OcGz add OcLost 0.5 mul Mz OcHn div mul add /OcGz exch def
    /OcN OcGx dup mul OcGz dup mul add 1 add sqrt def
    OcGx neg OcN div 1 OcN div OcGz neg OcN div
} bind def

% --- colour by depth -------------------------------------------------------------
/OcColPrev /fc-water-colour load def
/fc-water-colour {                               % t depth -> r g b
    OcSea not { OcColPrev } { fc-ocean-colour } ifelse
} bind def
/fc-ocean-colour {                               % t depth -> r g b
    pop pop
    2.71828 OcD 0 fc-max SeaDepth div neg exp /OcM exch def
    % sky light, and sunlight (more of it over a bright bed)
    SunDir 1 get 0 fc-max OcM 0.6 mul 0.3 add mul /OcSy exch def
    0 1 2 { /OcI exch def
        SeaDeep OcI get SeaShallow OcI get SeaDeep OcI get sub OcM mul add
        SkyAmb OcI get 0.5 mul SunCol OcI get OcSy mul add mul
    } for
} bind def

% --- foam, glitter ---------------------------------------------------------------
% lace: noise thresholded so that cover f leaves about f of the surface
% white, fading to the flat mean where the lace is under three pixels
/fc-ocean-lace {                                 % f -> f'
    /OcF exch def
    1 FoamScale div OcFp 3 mul div 1 fc-min /OcFf exch def
    OcFf 0.05 gt OcF 0.01 gt and {
        /OcCw WindDir cos def /OcSw WindDir sin def
        OcX OcCw mul OcZ OcSw mul add FoamScale mul 0.5 mul 3.3 add
        OcZ OcCw mul OcX OcSw mul sub FoamScale mul 1.7 add fc-noise2
        OcX FoamScale mul 2.3 mul 0.6 add OcZ FoamScale mul 2.3 mul 9.1 add fc-noise2 0.4 mul add
        1.4 div /OcNs exch def
        1 OcF sub dup 0.12 sub exch 0.12 add OcNs fc-smooth
        OcFf mul OcF 1 OcFf sub mul add
    } { OcF } ifelse
} bind def

% Smith G1 for Beckmann slopes of variance OcS2: 2 / (1 + sqrt(1 + s² tan²))
/fc-ocean-g1 {                                   % cos -> g
    dup mul dup 1 exch sub exch div OcS2 mul 1 add sqrt 1 add 2 exch div
} bind def

/OcShadePrev /fc-water-shade load def
/fc-water-shade {                                % t -> r g b
    % the sea: the plane at WaterY, not a river or a lake above it
    AqRiv not WaterY null ne and { AqLev WaterY sub abs 0.0001 lt } { false } ifelse /OcSea exch def
    OcSea { fc-ocean-shade } { OcShadePrev } ifelse
} bind def
/fc-ocean-shade {                                % t -> r g b
    OcShadePrev /OcB exch def /OcG exch def /OcR exch def
    % sun glitter: a microfacet lobe, widened by the slope the waves lose
    GlitterGain 0 gt SunDir 1 get 0 gt and {
        SunDir 0 get Mx sub SunDir 1 get My sub SunDir 2 get Mz sub
        /OcVz exch def /OcVy exch def /OcVx exch def
        /OcVn OcVx dup mul OcVy dup mul add OcVz dup mul add sqrt def
        AqNrx OcVx mul AqNry OcVy mul add AqNrz OcVz mul add OcVn div 0.001 fc-max /OcNh exch def
        Mx OcVx mul My OcVy mul add Mz OcVz mul add neg OcVn div 0 fc-max /OcHv exch def
        Mx AqNrx mul My AqNry mul add Mz AqNrz mul add neg 0.05 fc-max /OcNv exch def
        GlitterRough dup mul OcLost AqLost add dup mul 0.5 mul add /OcS2 exch def
        1 OcNh dup mul sub OcNh dup mul div OcS2 div /OcE exch def
        OcE 30 lt {
            2.71828 OcE neg exp 3.14159 OcS2 mul OcNh dup mul dup mul mul div
            1 OcHv sub 5 exp 0.98 mul 0.02 add mul
            % Smith shadowing-masking (Beckmann, rational form) for the view
            % and the sun: without it the 1/(4 N.V) term blows up at grazing
            OcNv fc-ocean-g1 mul
            AqNrx SunDir 0 get mul AqNry SunDir 1 get mul add AqNrz SunDir 2 get mul add
            0.05 fc-max fc-ocean-g1 mul
            4 OcNv mul div 1.5 mul GlitterGain mul /OcSp exch def
            OcSp 0.002 gt ShadowsOn and { AqPx AqLev AqPz fc-terrain-shadow OcSp mul /OcSp exch def } if
            /OcR SunCol 0 get OcSp mul OcR add def
            /OcG SunCol 1 get OcSp mul OcG add def
            /OcB SunCol 2 get OcSp mul OcB add def
        } if
    } if
    % foam: steep swell crests ...
    FoamCrest FoamCrest 0.2 add OcH fc-smooth 0.8 mul
    % ... the breakers in the surf zone: a sharp front on the shoreward
    % side, the trail fading out to sea ...
    SurfFoam 0 gt OcD SurfDepth lt and {
        /OcDd OcD 0 fc-max def
        % distance to the waterline: depth over the bed's slope
        OcX 0.5 add OcZ SeaDepthOct fc-height OcX 0.5 sub OcZ SeaDepthOct fc-height sub
        dup mul
        OcX OcZ 0.5 add SeaDepthOct fc-height OcX OcZ 0.5 sub SeaDepthOct fc-height sub
        dup mul add sqrt 0.005 fc-max /OcSl exch def
        SurfDepth SurfDepth 0.7 mul OcDd fc-smooth
        OcDd OcSl div SurfSpacing div
        OcX 0.06 mul 4.1 add OcZ 0.06 mul 0.3 add fc-noise2 0.9 mul add
        dup floor sub SurfTrail div neg 2.71828 exch exp
        % lines under three pixels apart fade to their mean (no moire)
        SurfSpacing OcFp 3 mul div 1 fc-min /OcBf exch def
        OcBf mul 1 OcBf sub SurfTrail mul 1 2.71828 1 SurfTrail div neg exp sub mul add
        mul SurfFoam mul
        fc-max
        % ... and the swash at the waterline
        0 SurfDepth 0.15 mul OcDd fc-smooth 1 exch sub 0.9 mul SurfFoam mul fc-max
    } if
    fc-ocean-lace /OcF exch def
    OcF 0.002 gt {
        % foam lit by the sun (on the smooth swell) and the sky
        AqNrx SunDir 0 get mul AqNry SunDir 1 get mul add AqNrz SunDir 2 get mul add 0 fc-max
        1.5 mul /OcKl exch def
        OcKl 0 gt ShadowsOn and { AqPx AqLev AqPz fc-terrain-shadow OcKl mul /OcKl exch def } if
        0 1 2 { /OcI exch def
            FoamCol OcI get SunCol OcI get OcKl mul SkyAmb OcI get SkyLight mul add mul
        } for
        /OcFb exch def /OcFg exch def /OcFr exch def
        OcFr OcR sub OcF mul OcR add
        OcFg OcG sub OcF mul OcG add
        OcFb OcB sub OcF mul OcB add
    } { OcR OcG OcB } ifelse
} bind def

% --- wet sand -----------------------------------------------------------------------
% ground just above the waterline mirrors the sky (Fresnel on a level film)
/OcSurfPrev /fc-landscape-surface load def
/fc-landscape-surface {                          % t -> r g b
    dup /OcT exch def OcSurfPrev
    AqWet not WetSand 0 gt and WaterY null ne and { TreesOn { FsMat 1 ne } { true } ifelse } { false } ifelse {
        % the ground's height as the depth, swash and breakers see it
        % (SeaDepthOct octaves), so foam meets the band; the full-detail
        % height speckles it
        /OcWx Kx def /OcWz Kz def
        OcWx OcWz fc-water-level /OcWl exch def
        OcWl WaterY sub abs 0.0001 lt {
            OcWx OcWz SeaDepthOct fc-height OcWl sub
            OcWx 0.4 mul 7.3 add OcWz 0.4 mul 2.2 add fc-noise2 0.5 sub WetSand mul 0.5 mul add
            /OcWe exch def
            % the edge widens to the height a pixel spans on the slope, but
            % only on gentle ground near the water: on a steep wall that
            % height runs up the whole face, which then mirrored the sky (#78)
            OcT PixAng mul My abs 0.05 fc-max div
            1 Ny dup mul sub 0 fc-max sqrt Ny 0.05 fc-max div mul WetSand 2 mul fc-min /OcWp exch def
            OcWe WetSand OcWp add lt OcWe WetSand -0.5 mul OcWp sub gt and Ny WetSlope 0 get gt and {
                WetSand OcWp add WetSand 0.3 mul OcWp sub OcWe fc-smooth WetMirror mul
                WetSlope 0 get WetSlope 1 get Ny fc-smooth mul
                My neg 0 fc-max 1 exch sub 5 exp 0.98 mul 0.02 add mul /OcWw exch def
                OcWw 0.01 gt {
                    /OcB exch def /OcG exch def /OcR exch def
                    % sky and clouds only: no march over the ground (cheaper,
                    % and it can't meet the sand it leaves)
                    /OcSkyOnly true def
                    OcT My OcT mul CamY add fc-water-reflect-at
                    /OcSkyOnly false def
                    OcB sub OcWw mul OcB add 3 1 roll
                    OcG sub OcWw mul OcG add 3 1 roll
                    OcR sub OcWw mul OcR add 3 1 roll
                } if
            } if
        } if
    } if
} bind def

% --- sand ---------------------------------------------------------------------------
% fc-terrain-shade's material hook: sand on the bed and the beach, before
% fc_water's wet ground, light band and stones
/OcMatPrev /fc-terrain-material load def
/fc-terrain-material {
    SandHeight 0 gt {
        Kx Kz fc-water-level /OcMl exch def
        WaterY null ne { OcMl WaterY sub abs 0.0001 lt } { false } ifelse
        % with lib/fc_coast.ps (#39) the beach is the coast's: sand only under water
        { /fc-coast-material where { pop Kh OcMl lt } { true } ifelse } { false } ifelse {
            Kh OcMl sub
            Kx 0.05 mul 1.1 add Kz 0.05 mul 5.6 add fc-noise2 0.5 sub SandHeight mul add
            SandHeight SandHeight 0.6 mul 3 -1 roll fc-smooth
            0.72 0.85 Ny fc-smooth mul /OcSd exch def
            OcSd 0 gt {
                Kx 2.1 mul 0.4 add Kz 2.1 mul 3.3 add fc-noise2 0.5 sub 0.3 mul 0.15 0.35 Ke fc-smooth 1 exch sub mul 1 add /OcSm exch def
                Alb [ SandCol { OcSm mul } forall ] OcSd mix3v /Alb exch def
            } if
        } if
    } if
    OcMatPrev
} bind def

% with Profile, time the sea too
/ProfileProcs where { pop
    /ProfileProcs [ ProfileProcs aload pop /fc-ocean-lace ] def
} if
