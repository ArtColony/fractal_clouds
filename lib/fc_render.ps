%!PS-Adobe-3.0
% fc_render.ps -- the default renderer: one ray per pixel (fractal_clouds#1).
%
% A piece defines /fc-pixel { u v -> r g b } (setting /FcKey to the hit
% distance, or -1 for sky, if it wants antialiasing) and calls
%
%   pw ph fc-render -
%
% which fills a pw x ph point page with an image at one sample per device
% pixel (so `--dpi 144` doubles the detail), times /Res (default 1; 0.25
% for a quick composition check). It sets IW, IH and PixAng before the
% first pixel and prints the image size and render time. With /AA true,
% pixels on a depth edge get four extra samples (rotated grid) averaged in.
%
% u runs -1..1 across the image; v runs over the same scale (so +-ih/iw).
% Pixels are produced top row first, left to right, so a seeded fc-rnd
% gives the same picture every time.
%
% /Crop [x0 y0 x1 y1] (fractions of the frame, from the top left) renders
% only that rectangle, in place and at the full frame's detail, and leaves
% the rest of the page white: a way to look closely at a patch of a large
% render without paying for all of it.
%
% /PixSeed true (default false) reseeds the random stream (srand) from a
% hash of the pixel's position before its first sample, and a crop first
% computes the depth keys of the row above it and the pixel to its left.
% Each pixel then comes out the same however the frame is cropped, so the
% bands of scripts/render_bands.sh stitch into exactly the image of one
% uncropped PixSeed render, whatever the cut points. (Off, the random
% stream runs on from pixel to pixel, as gallery renders always have.)
%
% /RowTimes true (default false) prints `fc-row-t0 MS` (usertime when the
% render starts, i.e. after the bakes) and then `fc-row J MS` after each
% row, for render_bands.sh --auto.

/Res where { pop } { /Res 1 def } ifelse
/PixSeed where { pop } { /PixSeed false def } ifelse
/RowTimes where { pop } { /RowTimes false def } ifelse

% i j -> -: srand from a hash of the pixel position (xorshift, kept to 31
% bits): a plain j*65536+i seed would give rand's first draws a lattice
% pattern, since rand is a linear congruential generator
/fc-pix-srand {
    16 bitshift add 16#2545F491 xor
    2 {
        dup 13 bitshift xor 16#7fffffff and
        dup -17 bitshift xor
        dup 5 bitshift xor 16#7fffffff and
    } repeat
    srand
} bind def

% i j -> key: the depth key of pixel i, j's centre sample (colour dropped)
/fc-pix-key {
    2 copy fc-pix-srand
    IH 1 sub exch sub 0.5 add IH div 2 mul 1 sub FrAsp mul
    exch 0.5 add IW div 2 mul 1 sub exch
    /FcKey -1 def fc-pixel pop pop pop FcKey
} bind def

/fc-byte { 255 mul round cvi dup 255 gt { pop 255 } if dup 0 lt { pop 0 } if } bind def

/fc-render {                                     % pw ph -> -
    /FrPh exch def /FrPw exch def
    matrix defaultmatrix 0 get abs /FrDpp exch def    % device px per point
    /IW FrPw FrDpp mul Res mul round cvi 1 fc-max def
    /IH FrPh FrDpp mul Res mul round cvi 1 fc-max def
    /PixAng TanH 2 mul IW div def
    /FrKeyUp IW array def /FrKeyRow IW array def
    0 1 IW 1 sub { FrKeyUp exch -2 put } for
    /FrDu 2 IW div def                            % one pixel in u
    /FrAA 0 def
    /FrAsp IH IW div def
    /FrT0 usertime def
    /Crop where { pop Crop aload pop } { 0 0 1 1 } ifelse
    IH mul round cvi IH fc-min /FrJ1 exch def  IW mul round cvi IW fc-min /FrI1 exch def
    IH mul round cvi 0 fc-max /FrJ0 exch def   IW mul round cvi 0 fc-max /FrI0 exch def
    /FrCW FrI1 FrI0 sub 1 fc-max def /FrCH FrJ1 FrJ0 sub 1 fc-max def
    /FrRow FrCW 3 mul string def /FrJ FrJ0 def
    PixSeed FrJ0 0 gt and {                       % keys of the row above the crop
        FrI0 1 FrI1 1 sub { /FrI exch def FrKeyUp FrI  FrI FrJ0 1 sub fc-pix-key  put } for
    } if
    RowTimes { (fc-row-t0 ) print FrT0 = } if
    gsave
    FrPw FrI0 mul IW div  FrPh IH FrJ1 sub mul IH div translate
    FrPw FrCW mul IW div  FrPh FrCH mul IH div scale
    FrCW FrCH 8 [FrCW 0 0 FrCH neg 0 FrCH]
    {
        /FrV IH 1 sub FrJ sub 0.5 add IH div 2 mul 1 sub FrAsp mul def
        /FrKeyLeft -2 def
        PixSeed FrI0 0 gt and { /FrKeyLeft FrI0 1 sub FrJ fc-pix-key def } if
        FrI0 1 FrI1 1 sub {
            /FrI exch def
            /FrU FrI 0.5 add IW div 2 mul 1 sub def
            /FcKey -1 def
            PixSeed { FrI FrJ fc-pix-srand } if
            FrU FrV fc-pixel
            % antialias where the depth (FcKey, set by fc-pixel: the hit
            % distance, or -1 for sky) jumps against the left or upper
            % neighbour: average in four more rotated-grid samples
            AA {
                FcKey FrKeyLeft fc-key-edge FcKey FrKeyUp FrI get fc-key-edge or {
                    /FrK FcKey def
                    /FrAA FrAA 1 add def
                    [ 0.125 0.375  0.375 -0.125  -0.125 -0.375  -0.375 0.125 ] /FrOff exch def
                    /FrAb exch def /FrAg exch def /FrAr exch def
                    0 2 6 { /FrS exch def
                        FrU FrOff FrS get FrDu mul add  FrV FrOff FrS 1 add get FrDu mul add fc-pixel
                        FrAb add /FrAb exch def  FrAg add /FrAg exch def  FrAr add /FrAr exch def
                    } for
                    FrAr 5 div FrAg 5 div FrAb 5 div
                    /FcKey FrK def
                } if
            } if
            FrKeyRow FrI FcKey put /FrKeyLeft FcKey def
            fc-byte FrRow FrI FrI0 sub 3 mul 2 add 3 -1 roll put
            fc-byte FrRow FrI FrI0 sub 3 mul 1 add 3 -1 roll put
            fc-byte FrRow FrI FrI0 sub 3 mul 3 -1 roll put
        } for
        RowTimes { (fc-row ) print FrJ 9 string cvs print ( ) print usertime = } if
        /FrJ FrJ 1 add def
        FrKeyRow FrKeyUp /FrKeyRow exch def /FrKeyUp exch def
        FrRow
    }
    false 3 colorimage
    grestore
    (fc-render ) print FrCW 9 string cvs print (x) print FrCH 9 string cvs print
    ( of ) print IW 9 string cvs print (x) print IH 9 string cvs print
    ( px, antialiased ) print FrAA 9 string cvs print
    ( px, ms ) print usertime FrT0 sub =
} bind def

/fc-max { 2 copy lt { exch } if pop } bind def  % pscat has max; Ghostscript doesn't
/fc-min { 2 copy gt { exch } if pop } bind def

/AA where { pop } { /AA false def } ifelse
% k1 k2 -> bool: an edge if one is sky and the other isn't, or the
% distances differ by more than 8%; -2 means "no neighbour"
/fc-key-edge {
    /Fk2 exch def /Fk1 exch def
    Fk2 -2 eq { false } {
        Fk1 0 lt Fk2 0 lt ne { true } {
            Fk1 0 lt { false } {
                Fk1 Fk2 sub abs Fk1 Fk2 fc-max 0.08 mul gt
            } ifelse
        } ifelse
    } ifelse
} bind def
