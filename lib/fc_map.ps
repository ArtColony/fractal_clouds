%!PS-Adobe-3.0
% fc_map.ps -- terrain from a map: a painted grid and a feature list, baked
% into a table that fc-terrain-base reads (fractal_clouds#13).
%
% fc_terrain.ps loads this file when MapOn is true. Everything here is in
% map coordinates, which are the terrain's own: a view's camera stands at
% (TerrOX, TerrOZ) looking along +z turned by Yaw, so several views share
% one map by moving only the camera.
%
%   fc-map-bake -                    sample the grid and the features into
%                                    an MapN x MapN table over MapRect (done
%                                    at load; call again after changing them)
%   x z fc-terrain-base lift mask pin
%                                    the hook fc-height-proc calls:
%                                      lift  world units added to the ground
%                                      mask  0..1, where ridged mountains grow
%                                            (the massif mask the noise made)
%                                      pin   0..1, how firmly the map holds
%                                            the ground: the domain warp and
%                                            the noise massif fade out by it
%   pw ph fc-map-plan -              the map from above on a pw x ph page:
%                                    a hillshade of the procedural terrain
%                                    over MapPlanRect (or MapRect), with
%                                    the features drawn on it (ridges and
%                                    peaks yellow, valleys and lakes blue)
%   (label) x z yaw fc-map-plan-camera -
%                                    mark a viewpoint on the plan (the
%                                    current one is TerrOX TerrOZ Yaw)
%
% The map is MapGrid (a painted mask, or null) with MapFeatures on top:
%
%   MapGrid      an array of rows, the far (high z) row first, each a string
%                of MapChars (` .:-=+*#%@` runs 0..1) or an array of numbers
%                0..1; it is stretched over MapRect and gives the mask
%   MapFeatures  an array of features, each an array with a kind and its
%                numbers; heights and levels are world y:
%     [ /peak   height spread x z ]                raise the mask in a round
%                                                  bump of radius `spread`,
%                                                  so a peak about `height`
%                                                  high stands where a ridge
%                                                  crest crosses it
%     [ /ridge  height spread x0 z0 x1 z1 ... ]    the same along a polyline
%     [ /valley depth width x0 z0 x1 z1 ... ]      carve: the mask falls to
%                                                  0 along the polyline and
%                                                  the ground drops `depth`
%     [ /lake   level depth shore x0 z0 ... ]      a closed polygon (3 or more
%                                                  points): inside, the mask
%                                                  is 0 and the ground sits
%                                                  flat `depth` below `level`,
%                                                  the water surface a piece
%                                                  should put there; the bed
%                                                  blends to the surroundings
%                                                  over `shore` units centred
%                                                  on the edge
%
% Peaks and ridges are applied first (the tallest wins), then valleys, then
% lakes, whatever their order in the list. Each raises pin to its bump, so
% near features the ridges keep to the noise's own, unwarped network and
% land within about a ridge wavelength of where they were put. Outside
% MapRect, and wherever nothing is painted, the map is MapBackground
% [lift mask]; the table feathers to it over MapFeather units past the
% rectangle's edge. A new kind of feature is one more branch in the passes
% of fc-map-bake.
%
% The coast (#39): MapLiftGrid paints ground height (rows like MapGrid,
% 0..1 over MapLiftRange); /volcano, /atoll, /cliff and /stack features
% (docs/settings.md); MapSea, a sea level, makes the bake also measure the
% signed distance to the coastline (fc-map-coast) and loads fc_coast.ps.
%   x z fc-map-water y | -1000    the water level at a map point: MapSea
%                                 or a /lake's level, the higher

/MapRect [ -900 -900 900 900 ] fc-default     % x0 z0 x1 z1, map coordinates
/MapN 128 fc-default                          % table resolution
/MapGrid null fc-default
/MapChars ( .:-=+*#%@) fc-default
/MapFeatures [ ] fc-default
/MapBackground [ 0 0 ] fc-default             % lift mask where nothing is painted
/MapFeather 120 fc-default                    % blend to the background past MapRect
/MapPlanRect null fc-default                  % the plan's x0 z0 x1 z1 (null: MapRect)
/MapPlanN 150 fc-default                      % plan hillshade samples across
/MapPlanOct 5 fc-default                      % its terrain octaves
/MapLiftGrid null fc-default                  % a painted ground height (#39), rows like MapGrid
/MapLiftRange [ -10 30 ] fc-default           % the world y its 0 and 1 stand for
/MapVolcMask 0.22 fc-default                  % a /volcano's ridged mask (gullies on its flanks)
/MapSea null fc-default                       % sea level (#39): a number loads lib/fc_coast.ps

% d r -> b    a smooth bump, 1 at d = 0 and 0 from d = r on
/fc-map-bump {
    2 copy ge { pop pop 0 } { div dup mul 1 exch sub dup mul } ifelse
} bind def

% y -> mask    the massif mask that puts a ridge crest at height y
% (fc-terrain-relief: h = TerrH (mask (0.92 ridges + 0.18) + 0.06) + TerrBase,
% with ridges about 0.85 on the highest crest under a bump, measured with
% spikes/map_pins.ps, so 0.92 ridges + 0.18 = 0.962); a mask of 1 is the
% most it can ask, so peaks top out near TerrBase + 1.02 TerrH
/fc-map-mask-for {
    TerrBase sub TerrH div 0.06 sub 0.962 div dup 0 lt { pop 0 } if dup 1 gt { pop 1 } if
} bind def

% Distance from (MpX, MpZ) to the polyline in array MpA from index i0
% (x z pairs), and whether the point is inside it taken as a polygon.
%   arr i0 closed fc-map-dist d inside
/fc-map-dist {
    /MpCl exch def /MpI0 exch def /MpA exch def
    /MpNp MpA length MpI0 sub 2 idiv def
    /MpD2 1e30 def /MpIn false def
    MpNp 1 eq {
        MpX MpA MpI0 get sub dup mul MpZ MpA MpI0 1 add get sub dup mul add /MpD2 exch def
    } {
        0 1 MpCl { MpNp 1 sub } { MpNp 2 sub } ifelse { /MpK exch def
            /MpAx MpA MpI0 MpK 2 mul add get def  /MpAz MpA MpI0 MpK 2 mul add 1 add get def
            MpK 1 add MpNp mod 2 mul MpI0 add /MpKb exch def
            /MpBx MpA MpKb get def  /MpBz MpA MpKb 1 add get def
            /MpEx MpBx MpAx sub def /MpEz MpBz MpAz sub def
            /MpEl MpEx dup mul MpEz dup mul add def
            MpEl 0 eq { 0 } {
                MpX MpAx sub MpEx mul MpZ MpAz sub MpEz mul add MpEl div
                dup 0 lt { pop 0 } if dup 1 gt { pop 1 } if
            } ifelse /MpT exch def
            MpX MpAx MpEx MpT mul add sub dup mul
            MpZ MpAz MpEz MpT mul add sub dup mul add
            dup MpD2 lt { /MpD2 exch def } { pop } ifelse
            % crossing test for the inside
            MpCl MpAz MpZ gt MpBz MpZ gt ne and {
                MpX  MpZ MpAz sub MpEx mul MpEz div MpAx add  lt { /MpIn MpIn not def } if
            } if
        } for
    } ifelse
    MpD2 sqrt MpIn
} bind def

% t -> w0 w1 w2 w3    Catmull-Rom weights (the curve passes through the texels)
/fc-map-cw {
    /MpCt exch def /MpCt2 MpCt MpCt mul def /MpCt3 MpCt2 MpCt mul def
    MpCt3 neg MpCt2 2 mul add MpCt sub 0.5 mul
    MpCt3 3 mul MpCt2 5 mul sub 2 add 0.5 mul
    MpCt3 -3 mul MpCt2 4 mul add MpCt add 0.5 mul
    MpCt3 MpCt2 sub 0.5 mul
} bind def

% i j -> v    one painted texel (from MpGn, the grid as numbers), indices
% clamped to the grid
/fc-map-grid-get {
    dup 0 lt { pop 0 } if dup MpGnz 1 sub gt { pop MpGnz 1 sub } if MpGn exch get
    exch dup 0 lt { pop 0 } if dup MpGnx 1 sub gt { pop MpGnx 1 sub } if get
} bind def

% x z -> v    the painted grid at a map point, Catmull-Rom over 4x4 texels
/fc-map-grid-at {
    MpZ1 exch sub MpZ1 MpZ0 sub div MpGnz 1 sub mul /MpGz exch def     % far row first
    MpX0 sub MpX1 MpX0 sub div MpGnx 1 sub mul /MpGx exch def
    /MpGi MpGx floor cvi def /MpGj MpGz floor cvi def
    MpGx MpGi sub fc-map-cw /MpGw3 exch def /MpGw2 exch def /MpGw1 exch def /MpGw0 exch def
    MpGz MpGj sub fc-map-cw /MpGv3 exch def /MpGv2 exch def /MpGv1 exch def /MpGv0 exch def
    0
    /MpGr -2 def
    [ MpGv0 MpGv1 MpGv2 MpGv3 ] {
        /MpGr MpGr 1 add def
        MpGi 1 sub MpGj MpGr add fc-map-grid-get MpGw0 mul
        MpGi MpGj MpGr add fc-map-grid-get MpGw1 mul add
        MpGi 1 add MpGj MpGr add fc-map-grid-get MpGw2 mul add
        MpGi 2 add MpGj MpGr add fc-map-grid-get MpGw3 mul add
        mul add
    } forall
    dup 0 lt { pop 0 } if dup 1 gt { pop 1 } if
} bind def

% grid -> rows nx nz    a painted grid as rows of numbers 0..1
/fc-map-grid-parse {
    /MpGg exch def
    /MpGnz MpGg length def /MpGnx MpGg 0 get length def
    MpGg { length MpGnx ne {
        (fc-map: a painted grid's rows must all be the same length) =
        /fc-map-bake errordict /rangecheck get exec
    } if } forall
    [ MpGg { /MpGrow exch def
        [ MpGrow {
            MpGrow type /stringtype eq {
                /MpGc exch def 0
                0 1 MapChars length 1 sub { dup MapChars exch get MpGc eq { exch pop } { pop } ifelse } for
                MapChars length 1 sub div
            } if
        } forall ]
    } forall ] MpGnx MpGnz
} bind def

/fc-map-bake {
    /MpT0 usertime def
    /MpX0 MapRect 0 get def /MpZ0 MapRect 1 get def
    /MpX1 MapRect 2 get def /MpZ1 MapRect 3 get def
    /MpTx MpX1 MpX0 sub MapN 1 sub div def       % world units per texel
    /MpTz MpZ1 MpZ0 sub MapN 1 sub div def
    /MpFloor TerrBase TerrH 0.06 mul add def     % the valley floor's base height
    % the painted grids as numbers 0..1
    MapGrid null ne { MapGrid fc-map-grid-parse /MpMnz exch def /MpMnx exch def /MpMn exch def } if
    MapLiftGrid null ne { MapLiftGrid fc-map-grid-parse /MpLnz exch def /MpLnx exch def /MpLn exch def } if
    % the coast's extras (#39): any of them raises TerrTop over the tallest
    % lift, and stacks are kept for fc_coast.ps to draw
    /MpNew MapSea null ne MapLiftGrid null ne or def
    /MapStacks [ MapFeatures { dup 0 get /stack eq { } { pop } ifelse } forall ] def
    MapFeatures { 0 get dup /volcano eq exch /atoll eq or { /MpNew true def } if } forall
    MapStacks length 0 gt { /MpNew true def } if
    /MpLmax -1e30 def
    MapSea null ne { /MpCutT MapN 2 add dup mul array def } if
    % lift mask pin per texel, with one texel of margin all round (sampled
    % past the rectangle) so lookups at its edge have all four neighbours
    /MpW2 MapN 2 add def
    /MapTab MpW2 MpW2 mul 3 mul array def
    -1 1 MapN { /MpJ exch def
        /MpZ MpZ0 MpJ MpTz mul add def
        -1 1 MapN { /MpI exch def
            /MpX MpX0 MpI MpTx mul add def
            /MpL MapBackground 0 get def /MpM MapBackground 1 get def /MpP 0 def
            MapGrid null ne {
                /MpGn MpMn def /MpGnx MpMnx def /MpGnz MpMnz def
                MpX MpZ fc-map-grid-at /MpM exch def
            } if
            MapLiftGrid null ne {
                /MpGn MpLn def /MpGnx MpLnx def /MpGnz MpLnz def
                MpX MpZ fc-map-grid-at MapLiftRange 1 get MapLiftRange 0 get sub mul
                MapLiftRange 0 get add MpFloor sub /MpL exch def
            } if
            % 1. peaks and ridges raise the mask; the tallest wins
            MapFeatures { /MpF exch def
                MpF 0 get dup /peak eq exch /ridge eq or {
                    MpF 3 false fc-map-dist pop MpF 2 get fc-map-bump /MpB exch def
                    MpF 1 get MpL sub fc-map-mask-for MpB mul dup MpM gt { /MpM exch def } { pop } ifelse
                    MpB MpP gt { /MpP MpB def } if
                } if
                % island presets (#39): lift toward a ground height
                MpF 0 get /volcano eq {
                    MpF 3 false fc-map-dist pop /MpVd exch def
                    1 MpVd MpF 2 get div sub dup 0 lt { pop 0 } if 1.5 exp
                    MpVd MpF 2 get 0.1 mul fc-map-bump 0.25 mul sub /MpB exch def
                    MpF 1 get MpFloor sub TerrH MapVolcMask mul 0.64 mul sub MpL sub MpB mul
                    dup 0 gt { MpL add /MpL exch def } { pop } ifelse
                    MpVd MpF 2 get 0.9 mul fc-map-bump MapVolcMask mul dup MpM gt { /MpM exch def } { pop } ifelse
                    MpVd MpF 2 get fc-map-bump dup MpP gt { /MpP exch def } { pop } ifelse
                } if
                MpF 0 get /atoll eq {
                    MpF 4 false fc-map-dist pop MpF 2 get sub abs MpF 3 get fc-map-bump /MpB exch def
                    MpF 1 get MpFloor sub MpL sub MpB mul
                    dup 0 gt { MpL add /MpL exch def } { pop } ifelse
                    MpB MpP gt { /MpP MpB def } if
                } if
            } forall
            % 2. valleys carve
            MapFeatures { /MpF exch def
                MpF 0 get /valley eq {
                    MpF 3 false fc-map-dist pop MpF 2 get fc-map-bump /MpB exch def
                    /MpM MpM 1 MpB sub mul def
                    /MpL MpL MpF 1 get MpB mul sub def
                    MpB MpP gt { /MpP MpB def } if
                } if
            } forall
            % 3. lakes flatten
            MapFeatures { /MpF exch def
                MpF 0 get /lake eq {
                    MpF 4 true fc-map-dist { neg } if            % signed: negative inside
                    % the bed blends to the surroundings over `shore`
                    % units centred on the drawn edge, so the waterline
                    % lands near the line
                    MpF 3 get 2 div dup neg exch 3 -1 roll fc-smooth 1 exch sub /MpB exch def
                    /MpM MpM 1 MpB sub mul def
                    MpF 1 get MpF 2 get sub MpFloor sub MpL sub MpB mul MpL add /MpL exch def
                    MpB MpP gt { /MpP MpB def } if
                } if
            } forall
            MpL MpLmax gt { /MpLmax MpL def } if
            /MpGk MpJ 1 add MpW2 mul MpI add 1 add 3 mul def
            % 4. with a sea, how high the sea has cut the coast back (/cliff)
            MapSea null ne {
                /MpCut 0 def
                MapFeatures { /MpF exch def
                    MpF 0 get /cliff eq {
                        MpF 3 false fc-map-dist pop MpF 2 get fc-map-bump MpF 1 get mul
                        dup MpCut gt { /MpCut exch def } { pop } ifelse
                    } if
                } forall
                MpCutT MpGk 3 idiv MpCut put
            } if
            MapTab MpGk MpL put  MapTab MpGk 1 add MpM put  MapTab MpGk 2 add MpP put
        } for
    } for
    % the ceiling the march stops at: the tallest lift on top of the
    % tallest relief, and the stacks (only for maps that use the coast's
    % extras, so older pieces keep their pixels)
    MpNew {
        TerrH 1.25 mul TerrBase add MpLmax dup 0 lt { pop 0 } if add
        MapStacks { 1 get 1 add 2 copy lt { exch } if pop } forall
        dup TerrTop gt { /TerrTop exch def } { pop } ifelse
    } if
    MapSea null ne { fc-map-coast } if
    (fc-map: ) print MapN 9 string cvs print (^2 table, ) print MapFeatures length 9 string cvs print
    ( features, ms ) print usertime MpT0 sub =
} bind def

% w -> -    add one table row (four texels from MpGk, weights MpGw0..3)
% times w into MpL MpM MpP, and step MpGk to the next row
/fc-map-tab-row {
    /MpGv exch def
    MapTab MpGk get MpGw0 mul  MapTab MpGk 3 add get MpGw1 mul add
    MapTab MpGk 6 add get MpGw2 mul add  MapTab MpGk 9 add get MpGw3 mul add
    MpGv mul MpL add /MpL exch def
    MapTab MpGk 1 add get MpGw0 mul  MapTab MpGk 4 add get MpGw1 mul add
    MapTab MpGk 7 add get MpGw2 mul add  MapTab MpGk 10 add get MpGw3 mul add
    MpGv mul MpM add /MpM exch def
    MapTab MpGk 2 add get MpGw0 mul  MapTab MpGk 5 add get MpGw1 mul add
    MapTab MpGk 8 add get MpGw2 mul add  MapTab MpGk 11 add get MpGw3 mul add
    MpGv mul MpP add /MpP exch def
    /MpGk MpGk MpW2 3 mul add def
} bind def

% x z -> lift mask pin
/fc-terrain-base {
    /MpLz exch def /MpLx exch def
    % how far outside the rectangle, for the feather to the background
    MpX0 MpLx sub  MpLx MpX1 sub  2 copy lt { exch } if pop
    MpZ0 MpLz sub  2 copy lt { exch } if pop  MpLz MpZ1 sub  2 copy lt { exch } if pop
    dup 0 le { pop 1 } {
        MapFeather 0 le { pop 0 } { MapFeather div 1 exch sub dup 0 lt { pop 0 } if } ifelse
    } ifelse /MpW exch def
    MpW 0 le { MapBackground 0 get MapBackground 1 get 0 } {
        % texel coordinates, 0..MapN-1 over the rectangle, 1 more in the table
        MpLx MpX0 sub MpTx div dup 0 lt { pop 0 } if dup MapN 1.0001 sub gt { pop MapN 1.0001 sub } if 1 add /MpGx exch def
        MpLz MpZ0 sub MpTz div dup 0 lt { pop 0 } if dup MapN 1.0001 sub gt { pop MapN 1.0001 sub } if 1 add /MpGz exch def
        /MpGi MpGx floor cvi def /MpGj MpGz floor cvi def
        MpGx MpGi sub fc-map-cw /MpGw3 exch def /MpGw2 exch def /MpGw1 exch def /MpGw0 exch def
        MpGz MpGj sub fc-map-cw
        /MpL 0 def /MpM 0 def /MpP 0 def
        /MpGk MpGj 1 sub MpW2 mul MpGi add 1 sub 3 mul def       % texel (i-1, j-1)
        4 -1 roll fc-map-tab-row 3 -1 roll fc-map-tab-row exch fc-map-tab-row fc-map-tab-row
        MpM 0 lt { /MpM 0 def } if MpM 1 gt { /MpM 1 def } if
        MpP 0 lt { /MpP 0 def } if MpP 1 gt { /MpP 1 def } if
        MpW 1 lt {
            MapBackground 0 get dup MpL exch sub MpW mul add
            MapBackground 1 get dup MpM exch sub MpW mul add
            MpP MpW mul
        } { MpL MpM MpP } ifelse
    } ifelse
} bind def

% --- the coast (#39) ---------------------------------------------------------
% With MapSea set, the bake also measures every texel's signed distance to
% the coastline (land positive) into MapCoastD, and keeps in MapCoastC the
% ground height of the land nearest each sea texel (its own for land), so
% fc_coast.ps can tell a cliffed shore from a low one. A texel is land when
% its noise-free height, the base floor plus its lift plus the relief its
% mask grows on an average ridge (0.64 TerrH per unit of mask), stands at
% or above MapSea. The waterline between two texels is placed where that
% height crosses MapSea, then a two-pass chamfer (8 neighbours) carries
% the distance across each side. No noise here: the bake runs before
% fc-landscape-setup seeds it, so fc_coast.ps adds the wobble per point.
/fc-map-coast {
    /MpT1 usertime def
    /MpSea MapSea def
    /MpCn MpW2 MpW2 mul def
    /MpCe MpCn array def /MpCa MpCn array def
    0 1 MpCn 1 sub { /MpK exch def
        MpCa MpK  MapTab MpK 3 mul get  MapTab MpK 3 mul 1 add get TerrH mul 0.64 mul add MpFloor add  put
        MpCe MpK  MpCa MpK get MpCutT MpK get sub  put
    } for
    /MapCoastD MpCn array def /MapCoastC MpCn array def
    /MpTd MpTx dup mul MpTz dup mul add sqrt def
    % 1. texels next to the waterline: the distance to the crossing
    0 1 MpW2 1 sub { /MpJ exch def
        0 1 MpW2 1 sub { /MpI exch def
            /MpK MpJ MpW2 mul MpI add def
            /MpE MpCe MpK get def /MpLd MpE MpSea ge def
            /MpCd 1e6 def /MpCc MpLd { MpCa MpK get } { MpSea } ifelse def
            [ -1 0 MpTx  1 0 MpTx  0 -1 MpTz  0 1 MpTz ] /MpNb exch def
            0 3 9 { /MpQ exch def
                MpI MpNb MpQ get add /MpI2 exch def MpJ MpNb MpQ 1 add get add /MpJ2 exch def
                MpI2 0 ge MpI2 MpW2 lt and MpJ2 0 ge and MpJ2 MpW2 lt and {
                    MpCe MpJ2 MpW2 mul MpI2 add get /MpE2 exch def
                    MpE2 MpSea ge MpLd ne {
                        MpE MpSea sub MpE MpE2 sub div MpNb MpQ 2 add get mul
                        dup MpCd lt { /MpCd exch def MpLd not { /MpCc MpCa MpJ2 MpW2 mul MpI2 add get def } if } { pop } ifelse
                    } if
                } if
            } for
            MapCoastD MpK MpCd put MapCoastC MpK MpCc put
        } for
    } for
    % 2. chamfer, forward then back, within each side
    [ [ -1 0 MpTx  -1 -1 MpTd  0 -1 MpTz  1 -1 MpTd ] [ 1 0 MpTx  1 1 MpTd  0 1 MpTz  -1 1 MpTd ] ]
    /MpNbs exch def
    0 1 1 { /MpPass exch def
        /MpNb MpNbs MpPass get def
        0 1 MpCn 1 sub { MpPass 1 eq { MpCn 1 sub exch sub } if /MpK exch def
            /MpI MpK MpW2 mod def /MpJ MpK MpW2 idiv def
            /MpLd MpCe MpK get MpSea ge def
            0 3 9 { /MpQ exch def
                MpI MpNb MpQ get add /MpI2 exch def MpJ MpNb MpQ 1 add get add /MpJ2 exch def
                MpI2 0 ge MpI2 MpW2 lt and MpJ2 0 ge and MpJ2 MpW2 lt and {
                    /MpK2 MpJ2 MpW2 mul MpI2 add def
                    MpCe MpK2 get MpSea ge MpLd eq {
                        MapCoastD MpK2 get MpNb MpQ 2 add get add
                        dup MapCoastD MpK get lt {
                            MapCoastD exch MpK exch put
                            MpLd not { MapCoastC MpK MapCoastC MpK2 get put } if
                        } { pop } ifelse
                    } if
                } if
            } for
        } for
    } for
    % 3. signed: land positive
    0 1 MpCn 1 sub { /MpK exch def
        MpCe MpK get MpSea lt { MapCoastD MpK 2 copy get neg put } if
    } for
    /MpCe null def /MpCa null def
    (fc-map: coast ms ) print usertime MpT1 sub =
} bind def

% x z -> d c    the coast table at a map point: signed distance to the
% coastline (Catmull-Rom) and the nearest land's height (bilinear); past
% MapRect the edge texels carry on
/fc-map-coast-at {
    MpZ0 sub MpTz div dup 0 lt { pop 0 } if dup MapN 1.0001 sub gt { pop MapN 1.0001 sub } if 1 add /MpCz exch def
    MpX0 sub MpTx div dup 0 lt { pop 0 } if dup MapN 1.0001 sub gt { pop MapN 1.0001 sub } if 1 add /MpCx exch def
    /MpCi MpCx floor cvi def /MpCj MpCz floor cvi def
    /MpCu MpCx MpCi sub def /MpCv MpCz MpCj sub def
    MpCu fc-map-cw /MpCw3 exch def /MpCw2 exch def /MpCw1 exch def /MpCw0 exch def
    /MpCk MpCj 1 sub MpW2 mul MpCi add 1 sub def
    0
    MpCv fc-map-cw 4 array astore {
        MapCoastD MpCk get MpCw0 mul  MapCoastD MpCk 1 add get MpCw1 mul add
        MapCoastD MpCk 2 add get MpCw2 mul add  MapCoastD MpCk 3 add get MpCw3 mul add
        mul add
        /MpCk MpCk MpW2 add def
    } forall
    /MpCk MpCj MpW2 mul MpCi add def
    MapCoastC MpCk get 1 MpCu sub mul MapCoastC MpCk 1 add get MpCu mul add 1 MpCv sub mul
    MapCoastC MpCk MpW2 add get 1 MpCu sub mul MapCoastC MpCk MpW2 add 1 add get MpCu mul add MpCv mul add
} bind def

% x z -> y | -1000    the water level the map gives a point (map
% coordinates): the higher of MapSea and the level of any /lake whose
% polygon, or shore band, holds it; so a piece needn't repeat its levels
/fc-map-water {
    /MpZ exch def /MpX exch def
    MapSea null ne { MapSea } { -1000 } ifelse
    MapFeatures { /MpF exch def
        MpF 0 get /lake eq { MpF 1 get 1 index gt } { false } ifelse {
            MpF 4 true fc-map-dist exch MpF 3 get lt or { pop MpF 1 get } if
        } if
    } forall
} bind def

% --- the plan -------------------------------------------------------------
% x z -> px py    map point to page point (after fc-map-plan set the fit)
/fc-map-plan-pt {
    MqZ0 sub MpS mul MpOz add exch MqX0 sub MpS mul MpOx add exch
} bind def

% arr i0 fc-map-plan-path -    moveto the first point, lineto the rest
/fc-map-plan-path {
    /MpPp exch def /MpPa exch def
    MpPa MpPp get MpPa MpPp 1 add get fc-map-plan-pt moveto
    MpPp 2 add 2 MpPa length 1 sub { dup MpPa exch get exch 1 add MpPa exch get fc-map-plan-pt lineto } for
} bind def

/fc-map-plan {                                   % pw ph -> -
    /MpPgH exch def /MpPgW exch def
    /fc-landscape-setup where { pop LnSetUp not { fc-landscape-setup } if } if
    MapPlanRect null eq { MapRect } { MapPlanRect } ifelse
    dup 0 get /MqX0 exch def dup 1 get /MqZ0 exch def
    dup 2 get /MqX1 exch def 3 get /MqZ1 exch def
    % fit the rectangle into the page, centred
    MpPgW MqX1 MqX0 sub div  MpPgH MqZ1 MqZ0 sub div  2 copy gt { exch } if pop 0.96 mul /MpS exch def
    /MpOx MpPgW MqX1 MqX0 sub MpS mul sub 2 div def
    /MpOz MpPgH MqZ1 MqZ0 sub MpS mul sub 2 div def
    % hillshade of the procedural terrain, lit from the south-west, mixed
    % with height: black at TerrBase, white at TerrTop; water blue where the
    % ground is below a lake's level, inside it or within `shore` of its edge
    /MpNx MapPlanN def /MpNz MapPlanN MqZ1 MqZ0 sub mul MqX1 MqX0 sub div round cvi 1 fc-max def
    /MpRow MpNx 3 mul string def /MpPj 0 def
    /MpLo 1e9 def /MpHi -1e9 def
    /MpDd MqX1 MqX0 sub MpNx div 0.5 mul def     % the difference step, half a sample
    gsave
    MqX0 MqZ0 fc-map-plan-pt translate
    MqX1 MqX0 sub MpS mul MqZ1 MqZ0 sub MpS mul scale
    MpNx MpNz 8 [ MpNx 0 0 MpNz neg 0 MpNz ] {
        /MpPz MqZ1 MpPj 0.5 add MpNz div MqZ1 MqZ0 sub mul sub def
        0 1 MpNx 1 sub { /MpPi exch def
            /MpPx MqX0 MpPi 0.5 add MpNx div MqX1 MqX0 sub mul add def
            MpPx TerrOX sub MpPz TerrOZ sub MapPlanOct fc-height-proc /MpPh exch def
            MpPh MpLo lt { /MpLo MpPh def } if MpPh MpHi gt { /MpHi MpPh def } if
            MpPx MpDd add TerrOX sub MpPz TerrOZ sub MapPlanOct fc-height-proc MpPh sub
            MpPx TerrOX sub MpPz MpDd add TerrOZ sub MapPlanOct fc-height-proc MpPh sub
            add MpDd div neg 0.2 mul 0.5 add
            MpPh TerrBase sub TerrTop TerrBase sub div 0.5 mul add
            dup 0 lt { pop 0 } if dup 1 gt { pop 1 } if /MpPv exch def
            /MpPw -1 def                         % water depth here, if any
            MapFeatures { /MpF exch def
                MpF 0 get /lake eq { MpPh MpF 1 get lt } { false } ifelse {
                    /MpX MpPx def /MpZ MpPz def
                    MpF 4 true fc-map-dist exch MpF 3 get lt or {
                        MpF 1 get MpPh sub dup MpPw gt { /MpPw exch def } { pop } ifelse
                    } if
                } if
            } forall
            MapSea null ne { MapSea MpPh sub dup MpPw gt { /MpPw exch def } { pop } ifelse } if
            MpPw 0 ge {
                MpPw 4 div 1 fc-min 0.35 mul 1 exch sub MpPv 0.15 mul 0.85 add mul /MpPv exch def
                [ 0.42 0.58 0.82 ]
            } { [ 1 1 1 ] } ifelse
            { MpPv mul 255 mul cvi dup 255 gt { pop 255 } if } forall
            MpRow MpPi 3 mul 2 add 3 -1 roll put
            MpRow MpPi 3 mul 1 add 3 -1 roll put
            MpRow MpPi 3 mul 3 -1 roll put
        } for
        /MpPj MpPj 1 add def MpRow
    } false 3 colorimage
    grestore
    % the features
    0.8 setlinewidth 1 setlinecap 1 setlinejoin
    MapFeatures { /MpF exch def
        MpF 0 get /lake eq {
            0.25 0.40 0.70 setrgbcolor
            gsave [ 2 1.5 ] 0 setdash MpF 4 fc-map-plan-path closepath stroke grestore
        } if
        MpF 0 get /valley eq {
            0.30 0.50 0.85 setrgbcolor MpF 3 fc-map-plan-path stroke
        } if
        MpF 0 get dup /ridge eq exch /peak eq or {
            1 0.92 0.55 setrgbcolor
            MpF length 5 gt { MpF 3 fc-map-plan-path stroke } if
            % a small triangle at every vertex
            3 2 MpF length 1 sub { dup MpF exch get exch 1 add MpF exch get fc-map-plan-pt
                /MpVy exch def /MpVx exch def
                MpVx MpVy 2.4 add moveto MpVx 2.2 sub MpVy 1.4 sub lineto MpVx 2.2 add MpVy 1.4 sub lineto
                closepath fill
            } for
        } if
    } forall
    (fc-map-plan: heights min ) print MpLo 20 string cvs print ( max ) print MpHi 20 string cvs print
    ( over ) print [ MqX0 MqZ0 MqX1 MqZ1 ] { 9 string cvs print ( ) print } forall ( ) =
} bind def

% (label) x z yaw fc-map-plan-camera -    a red dot, the field of view, a label
/fc-map-plan-camera {
    /MpCy exch def fc-map-plan-pt /MpCpy exch def /MpCpx exch def
    gsave
    1 0.15 0.1 setrgbcolor 0.7 setlinewidth
    MpCpx MpCpy 2.5 0 360 arc fill
    [ HFov 2 div neg HFov 2 div ] {
        MpCy add /MpCa exch def
        MpCpx MpCpy moveto
        MpCa sin MqX1 MqX0 sub 0.3 mul MpS mul mul MpCpx add
        MpCa cos MqX1 MqX0 sub 0.3 mul MpS mul mul MpCpy add lineto stroke
    } forall
    /Helvetica findfont 7 scalefont setfont
    MpCpx 4 add MpCpy 4 sub moveto show
    grestore
} bind def

fc-map-bake
% the coast's shaping and materials
MapSea null ne { (lib/fc_coast.ps) run } if
