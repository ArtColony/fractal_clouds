%!PS-Adobe-3.0
% fc_noise2.ps -- fast 2D value noise and ridged fBm for fractal_clouds terrain.
%
%   seed fc-noise2-init -        fill the lattices (calls srand)
%   x y fc-noise2 v              value noise, v in 0..1, period 64 per axis
%   x y oct fc-ridged v          ridged multifractal on gradient noise, 0..1
%
% Same layout trick as fc_noise3.ps: a 65x65 lattice with the border copied,
% so a cell's four corners are fixed offsets from one base index. Each
% octave of fc-ridged is rotated about 37 degrees and offset, so ridges don't
% line up with the lattice axes. A fractional octave count fades the last
% octave in, so detail can drop smoothly with distance.

/FcN2 65 65 mul array def

/fc-noise2-init {                                % seed -> -
    srand
    0 1 63 { /gy exch def
      0 1 63 { /gx exch def
        FcN2 gy 65 mul gx add  rand 16#7fffffff div  put
      } for } for
    0 1 64 { /gy exch def
      0 1 64 { /gx exch def
        gx 64 eq gy 64 eq or {
          FcN2 gy 65 mul gx add  FcN2 gy 63 and 65 mul gx 63 and add get put
        } if
      } for } for
    fc-gnoise2-init
} bind def

/fc-noise2 {                                     % x y -> v
    dup floor dup 3 1 roll sub
    dup dup mul exch 2 mul 3 exch sub mul /N2v exch def
    cvi 63 and 65 mul                            % x yo
    exch
    dup floor dup 3 1 roll sub
    dup dup mul exch 2 mul 3 exch sub mul /N2u exch def
    cvi 63 and add /N2b exch def
    FcN2 N2b get       FcN2 N2b 1 add get   1 index sub N2u mul add
    FcN2 N2b 65 add get FcN2 N2b 66 add get 1 index sub N2u mul add
    1 index sub N2v mul add
} bind def

% Gradient (Perlin-style) noise on the same 65x65 layout: a random unit
% gradient per lattice point. Its zero crossings form a connected network of
% lines, which is what ridged noise needs; ridges built on value noise trace
% closed contours around blobs instead.
%   x y fc-gnoise2 n     n roughly -0.7..0.7
/FcG2x 65 65 mul array def /FcG2y 65 65 mul array def
/fc-gnoise2-init {                               % (after fc-noise2-init) -> -
    0 1 63 { /gy exch def
      0 1 63 { /gx exch def
        rand 16#7fffffff div 360 mul /ga exch def
        FcG2x gy 65 mul gx add ga cos put
        FcG2y gy 65 mul gx add ga sin put
      } for } for
    0 1 64 { /gy exch def
      0 1 64 { /gx exch def
        gx 64 eq gy 64 eq or {
          FcG2x gy 65 mul gx add  FcG2x gy 63 and 65 mul gx 63 and add get put
          FcG2y gy 65 mul gx add  FcG2y gy 63 and 65 mul gx 63 and add get put
        } if
      } for } for
} bind def

/fc-gnoise2 {                                    % x y -> n
    /G2y exch def /G2x exch def
    /G2fx G2x floor def /G2fy G2y floor def
    /G2u G2x G2fx sub def /G2v G2y G2fy sub def
    /G2b G2fy cvi 63 and 65 mul G2fx cvi 63 and add def
    /G2s G2u dup mul 3 G2u 2 mul sub mul def
    /G2t G2v dup mul 3 G2v 2 mul sub mul def
    FcG2x G2b get G2u mul FcG2y G2b get G2v mul add
    FcG2x G2b 1 add get G2u 1 sub mul FcG2y G2b 1 add get G2v mul add
    1 index sub G2s mul add
    FcG2x G2b 65 add get G2u mul FcG2y G2b 65 add get G2v 1 sub mul add
    FcG2x G2b 66 add get G2u 1 sub mul FcG2y G2b 66 add get G2v 1 sub mul add
    1 index sub G2s mul add
    1 index sub G2t mul add
} bind def

% Musgrave-style ridged multifractal: each octave is 1 - |2n - 1|, squared,
% and weighted by the previous octave, so detail piles up on the ridges and
% valleys stay smooth.
/fc-ridged {                                     % x y oct -> v
    /R2o exch def /R2y exch def /R2x exch def
    /R2sum 0 def /R2amp 0.5 def /R2w 1 def /R2norm 0 def
    /R2k 0 def
    {
        R2k R2o ge { exit } if
        % the last, fractional octave fades in
        R2o R2k sub dup 1 gt { pop 1 } if /R2f exch def
        R2x R2y fc-gnoise2 abs 1.6 mul 1 exch sub dup 0 lt { pop 0 } if dup mul
        dup R2w mul R2amp mul R2f mul R2sum add /R2sum exch def
        2 mul dup 1 gt { pop 1 } if /R2w exch def
        R2amp R2f mul R2norm add /R2norm exch def
        /R2amp R2amp 0.5 mul def
        % rotate ~37 degrees, scale 2, offset
        R2x 1.6 mul R2y 1.2 mul sub 3.1 add
        R2x 1.2 mul R2y 1.6 mul add 7.7 add
        /R2y exch def /R2x exch def
        /R2k R2k 1 add def
    } loop
    R2sum R2norm div
} bind def

% Value noise with its analytic gradient, for erosion-style fBm.
%   x y fc-noise2d v dvdx dvdy      (v in 0..1)
/fc-noise2d {
    /D2y exch def /D2x exch def
    /D2fx D2x floor def /D2fy D2y floor def
    /D2u D2x D2fx sub def /D2v D2y D2fy sub def
    /D2du D2u 1 D2u sub mul 6 mul def            % d smoothstep / du
    /D2dv D2v 1 D2v sub mul 6 mul def
    /D2u D2u dup mul 3 D2u 2 mul sub mul def
    /D2v D2v dup mul 3 D2v 2 mul sub mul def
    /D2b D2fy cvi 63 and 65 mul D2fx cvi 63 and add def
    /D2a0 FcN2 D2b get def          /D2a1 FcN2 D2b 1 add get def
    /D2a2 FcN2 D2b 65 add get def   /D2a3 FcN2 D2b 66 add get def
    /D2k D2a0 D2a1 sub D2a2 sub D2a3 add def
    D2a0  D2a1 D2a0 sub D2u mul add  D2a2 D2a0 sub D2v mul add  D2k D2u D2v mul mul add
    D2a1 D2a0 sub D2k D2v mul add D2du mul
    D2a2 D2a0 sub D2k D2u mul add D2dv mul
} bind def

% Erosion fBm: each octave is damped by the slope accumulated so far, so
% steep ground stays smooth (runoff) and detail gathers on flats and ridges.
%   x y oct fc-eroded v   (roughly 0..1; fractional oct fades the last in)
/fc-eroded {
    /E2o exch def /E2y exch def /E2x exch def
    /E2sum 0 def /E2amp 0.5 def /E2gx 0 def /E2gy 0 def /E2k 0 def /E2norm 0 def
    {
        E2k E2o ge { exit } if
        E2o E2k sub dup 1 gt { pop 1 } if /E2f exch def
        E2x E2y fc-noise2d                       % v dx dy
        2 mul E2gy add /E2gy exch def
        2 mul E2gx add /E2gx exch def
        2 mul 1 sub                              % -1..1
        1 E2gx E2gx mul E2gy E2gy mul add 1 add div mul
        E2amp mul E2f mul E2sum add /E2sum exch def
        E2amp E2f mul E2norm add /E2norm exch def
        /E2amp E2amp 0.5 mul def
        % rotate ~37 degrees and double; rotate the gradient with the domain
        E2x 1.6 mul E2y 1.2 mul sub 3.1 add
        E2x 1.2 mul E2y 1.6 mul add 7.7 add
        /E2y exch def /E2x exch def
        E2gx 0.8 mul E2gy 0.6 mul sub
        E2gx 0.6 mul E2gy 0.8 mul add
        /E2gy exch def /E2gx exch def
        /E2k E2k 1 add def
    } loop
    E2sum E2norm div 0.5 mul 0.5 add
} bind def
