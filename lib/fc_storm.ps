%!PS-Adobe-3.0
% fc_storm.ps -- a cumulonimbus placed in the scene like a mountain
% (fractal_clouds#15).
%
% Load it after lib/fc_landscape.ps (it needs fc_clouds.ps and fc_noise2.ps):
% it puts one storm layer in front of CloudLayers (any other layers must lie
% wholly above the storm's band, StormTop + DomeR). The storm is a cloud
% layer whose band runs from the base to the top of the dome; its
% Shape (fc-storm-shape) is a signed field, positive inside the envelope,
% that the layer's billow noise breaks into turrets; its Bounds box keeps
% the march (and the noise) to the storm's neighbourhood. Rain shafts are
% the layer's Rain; virga hang under the anvil from the Shape.
%
%   x y z oct fc-storm-shape dd     the envelope, in noise units (the Shape)
%   fc-storm-layer dict             the storm layer, from the settings
%
% Coordinates: world x z (the camera stands at x = z = 0); u runs from the
% storm's centre downwind (StormWind), w across the wind.

/StormDist 420 fc-default            % ground distance from the camera to the tower's foot
/StormAzim 0 fc-default              % its bearing, degrees: 0 is +z, 90 is +x (as SunAzim)
/StormBase 70 fc-default             % the dark base
/StormTop 180 fc-default             % the anvil's top at the tower
/StormR 55 fc-default                % tower radius at the base
/StormFlare 0.3 fc-default           % the tower is this much wider at the top
/StormLean 0.15 fc-default           % the tower leans downwind this much per unit height
/StormWind 0 fc-default              % where the anvil spreads, degrees from +x (as a layer's Wind)
/AnvilBot 152 fc-default             % the anvil's underside at the tower (it thins outward)
/AnvilR 170 fc-default               % how far it spreads downwind (upwind: a third of it)
/AnvilW 0.4 fc-default              % its half-width across the wind, as a fraction of AnvilR
/AnvilRoot 1.6 fc-default            % its overhang round the tower top, in the tower's radius
/AnvilBack 0.1 fc-default            % how far it reaches upwind past that, as a fraction of AnvilR
/AnvilFiber 0 fc-default             % > 0: streaks along the wind fray it, this strong
/AnvilThin 6 fc-default              % the ice near its edge, thinning to nothing on the outline
/AnvilTopSoft 1.5 fc-default         % its level top's softness, units (small: a sharp, flat top)
/AnvilBotSoft 8 fc-default           % its underside's softness, units
/AnvilMamma 0 fc-default             % > 0: mammatus pouches this deep under it, near the tower
/AnvilDens 1 fc-default              % its density, as a share of the tower's (thin ice)
/AnvilShade 1 fc-default             % its share of StormShade (< 1: thin ice lets the sun through)
/AnvilAmbOcc 1 fc-default            % its share of StormAmbOcc (< 1: its underside keeps more sky)
/AnvilFlare 1.5 fc-default            % how fast it thins away from the tower (higher: its underside
                                     % sweeps up from the tower sooner, a flared trumpet)
/AnvilTilt 0 fc-default              % its top falls this much per unit downwind
/StormFootR 0.8 fc-default           % the tower's radius at the base, as a fraction of StormR
/StormBulge 0 fc-default             % > 0: the tower bulges in lobes this strong (fraction of R)
/StormBulgeScale 0.03 fc-default     % those lobes, cells per unit
/StormBaseRag 0 fc-default           % > 0: the base fades in over this many units, unevenly
/DomeR 34 fc-default                 % the overshooting dome above the top; 0 for none
/StormEdge 2 fc-default              % envelope gain: higher = smoother, tighter outline
/Virga 0.3 fc-default                % strength of the streaks under the anvil; 0 for none
/VirgaLen 26 fc-default              % how far they hang
/VirgaScale 0.2 fc-default           % their streaks, cells per unit
/StormRain 84 fc-default             % rain shafts this far below the base (the layer's Rain)
/StormRainDens 0.3 fc-default       % their density, as a fraction of the cloud's
/StormRainSlant 0 fc-default         % the rain is blown downwind this much per unit it falls
/StormRainSoft 0 fc-default          % the rain fades out this far past the tower's foot (in envelope
                                     % units: 0.5 is half a radius), so the curtain has soft sides
/StormRainSpread 0 fc-default        % > 0: the soft sides widen to StormRainSoft over this many units
                                     % below the base (0: at once)
/StormRainFine 0 fc-default          % > 0: fine streaks in the shafts, this strong (0..1)
/AnvilEdge 4 fc-default              % the anvil's envelope gain, relative to the tower's
/StormShade 0.25 fc-default          % optical depth per unit length of envelope toward the sun
/StormShadeN 5 fc-default /StormShadeStep 16 fc-default    % its steps
/StormGloom 0 fc-default             % > 0: the air under the storm is shaded: this much
                                     % extinction per unit of ray under the base, inside
                                     % StormGloomR, toward StormGloomCol (wraps fc-landscape-grade)
/StormGloomR 2 fc-default            % that column's radius, in StormR
/StormGloomCol [ 0.10 0.11 0.13 ] fc-colour
/StormAmbOcc 0.1 fc-default          % the sky light a sample loses to the cloud above it: this
                                     % share of the optical depth StormAmbStep straight up
/StormAmbStep 5 fc-default
/StormBaseDark 0.3 fc-default        % the sky light at the base, as a share of the light
                                     % StormBaseDarkH * (StormTop - StormBase) up the tower
/StormBaseDarkH 0.5 fc-default
/StormSkyDim 0.85 fc-default          % the sky the storm hides from the ground round it, at
                                     % most (under it); wraps fc-cloud-sky, so it acts only
                                     % where CloudSkyDim > 0
/StormSkyR 5 fc-default              % how far that reaches: half as much this far from the
                                     % tower's axis or the anvil's middle, in StormR
/StormLayer << >> fc-default         % overrides for the storm layer's keys (docs/settings.md)

% --- derived ------------------------------------------------------------------
/StCx StormDist StormAzim sin mul def
/StCz StormDist StormAzim cos mul def
/StWc StormWind cos def /StWs StormWind sin def
/StH StormTop StormBase sub def
/StTw StormR StormFlare mul StH div def      % radius growth per unit height
/StTopU StormLean StH mul def                % the tower top's offset downwind
/StAh StormTop AnvilBot sub 1 fc-max def
/StRa AnvilR StormR add def                  % the anvil's widest reach
/StRt StormR StormFlare 1 add mul StormFootR 1 add 0.5 mul mul def   % the tower top's radius (about)
/StRo StRt AnvilRoot mul def                 % the anvil's overhang round it

% the tower's radius at height h above the base: StormFootR of StormR at the
% base, swelling to StormR (times the flare) a little over half way up and
% drawing in under the anvil, so the column bulges; then broken into
% cauliflower lobes by a 3-D noise of StormBulgeScale cells per unit,
% StormBulge strong (#134: a straight column read as a drum)
/fc-storm-towerr {                               % x y z h -> R
    StH div 0 fc-max 1 fc-min /SmT exch def
    SmT 153 mul sin 1 StormFootR sub mul StormFootR add
    SmT StormFlare mul 1 add mul StormR mul
    StormBulge 0 gt {
        4 1 roll StormBulgeScale mul 3.7 add exch StormBulgeScale mul 0.8 mul 1.3 add
        3 -1 roll StormBulgeScale mul 6.1 add fc-noise3 0.5 sub 2 mul StormBulge mul 1 add mul
    } { 4 1 roll pop pop pop } ifelse
} bind def

% the anvil at height y: how far inside its outline (u w) lies, > 0 inside.
% In plan it caps the tower, overhanging it by AnvilRoot of its radius all
% round, and fans out downwind to AnvilR, its half-width growing by AnvilW
% of AnvilR; upwind it reaches AnvilBack of AnvilR past the overhang. Its
% top is level at StormTop (the tropopause; AnvilTilt lowers it downwind)
% and sharp (AnvilTopSoft units); its underside rises from AnvilBot at the
% tower to the top at the edge, as (1 - r)^AnvilFlare of the thickness (r:
% 0 at the tower, 1 on the outline), with a last AnvilThin of ice that
% thins to nothing there; the underside is soft (AnvilBotSoft units). So
% the edge fades rather than ending in a rounded rim (#137). Streaks along
% the wind (AnvilFiber), strongest toward the edge, fray it into cirrus.
% Leaves the plan value in SmAp and the underside's height in SmAb.
/fc-storm-anvil {                                % u w y -> s
    /SmAy exch def /SmAw exch def
    StTopU sub /SmAu exch def
    SmAu 0 ge {
        SmAu StRo AnvilR fc-max div /SmAa exch def
        SmAu AnvilR div 2 mul 1 fc-min sqrt AnvilR AnvilW mul mul StRo add
    } {
        SmAu neg StRo AnvilR AnvilBack mul add div /SmAa exch def StRo
    } ifelse /SmAW exch def
    SmAa dup mul SmAw SmAW div dup mul add sqrt /SmAr exch def
    /SmAp 1 SmAr sub def
    % cirrus: the outline frayed into streaks along the wind, more toward the
    % edge (AnvilFiber)
    AnvilFiber 0 gt {
        /SmAp SmAp SmAu 0.007 mul 4.7 add SmAy 0.03 mul SmAw 0.04 mul 2.2 add fc-noise3 0.5 sub
        SmAr 1 fc-min mul AnvilFiber mul add def
    } if
    StormTop SmAu 0 fc-max AnvilTilt mul sub /SmAt exch def
    SmAp 0 fc-max /SmAh exch def
    SmAh AnvilFlare exp StAh mul SmAh 0.3 exp AnvilThin mul add /SmAh exch def
    /SmAb SmAt SmAh sub def
    % mammatus: rounded pouches hanging from the underside where the anvil
    % is thick, near the tower, as deep as AnvilMamma
    AnvilMamma 0 gt {
        /SmAb SmAb 0.45 0.85 SmX 0.08 mul 1.1 add SmZ 0.08 mul 7.3 add fc-noise2 fc-smooth
        0.3 0.7 SmAp fc-smooth mul AnvilMamma mul sub def
    } if
    SmAy SmAb sub AnvilBotSoft div SmAt SmAy sub AnvilTopSoft div fc-min
    SmAp 0 lt { SmAp 10 mul add } if             % outside the outline: none
} bind def

% the envelope without noise: > 0 inside, 1 on the axis (sets SmX SmY SmZ
% SmU SmW, relative to the storm; the tower's and dome's value in SmTs, the
% anvil's in SmAs)
/fc-storm-env {                                  % x y z -> s
    StCz sub /SmZ exch def /SmY exch def StCx sub /SmX exch def
    /SmU SmX StWc mul SmZ StWs mul add def
    /SmW SmZ StWc mul SmX StWs mul sub def
    /SmH SmY StormBase sub def
    % tower: a leaning column that bulges in lobes, ending at the top
    SmY StormTop gt { -9 } {
        SmU SmH StormLean mul sub dup mul SmW dup mul add sqrt
        SmX SmY SmZ SmH fc-storm-towerr div 1 exch sub
        % a ragged base: toward the tower's edge the bottom StormBaseRag
        % units fade in over a noise, so the base frays there, not a flat
        % lid; toward the axis it stays solid down to the rain (frayed
        % there too, it left a lit gap of sky between the cloud and the rain)
        StormBaseRag 0 gt {
            dup 1.5 mul SmH StormBaseRag div add
            SmX 0.08 mul 2.3 add SmY 0.08 mul SmZ 0.08 mul 9.1 add fc-noise3 0.6 mul sub
            fc-min
        } if
    } ifelse
    % overshooting dome over the tower top, rising DomeR above the anvil
    DomeR 0 gt { SmY StormTop DomeR sub gt {
        SmU StTopU sub dup mul SmW dup mul add SmY StormTop sub dup mul add sqrt
        DomeR div 1 exch sub 2 mul fc-max
    } if } if
    /SmTs exch def
    % anvil: smoother than the tower (AnvilEdge)
    SmY AnvilBot AnvilMamma sub gt SmY StormTop 1 add lt and {
        SmU SmW SmY fc-storm-anvil AnvilEdge mul
    } { -9 } ifelse /SmAs exch def
    SmTs SmAs fc-max
} bind def

/fc-storm-shape {                                % x y z oct -> dd
    pop fc-storm-env StormEdge mul
    % the anvil is thin ice: AnvilDens of the tower's density, ramping up to
    % the tower's inside it (the layer's ShapeMul, #137)
    /FcShapeMul -0.6 0.2 SmTs fc-smooth 1 AnvilDens sub mul AnvilDens add def
    % virga: a soft curtain hanging from the anvil's underside (SmAb), as
    % deep as VirgaLen, densest at the underside and where the anvil is
    % thick in plan, streaked by a 2-D noise of VirgaScale cells per unit
    % (#101; #134: measured from the underside of the wedge)
    Virga 0 gt { SmY AnvilBot VirgaLen sub gt SmY StormTop lt and { dup 0.2 lt {
        SmU SmW SmY fc-storm-anvil pop
        SmAb SmY sub dup 0 gt SmAp 0 gt and {
            VirgaLen div 1 exch sub SmAp 3 mul 1 fc-min mul
            0.3 0.7 SmX VirgaScale mul 3.1 add SmZ VirgaScale mul 8.7 add fc-noise2 fc-smooth mul
            Virga mul 0.15 sub fc-max
        } { pop } ifelse
    } if } if } if
} bind def

% the storm's own shadow on itself (the layer's LightDepth): the noise's
% two sun probes reach only 2 ShadStep; past them, StormShadeN steps of
% StormShadeStep through the envelope toward the sun, so the far side of
% the tower and everything under the anvil goes dark
/fc-storm-depth {                                % x y z -> optical depth
    /SdZ exch def /SdY exch def /SdX exch def
    0 0 1 StormShadeN 1 sub {
        StormShadeStep mul ClSStep 2 mul add /SdT exch def
        SdX SunDir 0 get SdT mul add SdY SunDir 1 get SdT mul add SdZ SunDir 2 get SdT mul add
        fc-storm-env pop SmTs SmAs AnvilShade mul fc-max dup 0 gt { 1 fc-min add } { pop } ifelse
    } for
    StormShadeStep mul StormShade mul
} bind def

% the sky light at a sample (the layer's AmbShade): one density probe
% StormAmbStep straight up, so the undersides of the billows, the base and
% the underside of the anvil lose the sky above them, times a ramp from
% StormBaseDark at the base up the tower
/fc-storm-amb {                                  % x y z -> 0..1
    /SaZ exch def /SaY exch def /SaX exch def
    SaX SaY StormAmbStep add SaZ ClSOct fc-layer-density
    ClSig mul StormAmbStep mul StormAmbOcc mul SaY AnvilBot gt { AnvilAmbOcc mul } if
    neg 2.71828 exch exp
    StormBase StormBase StH StormBaseDarkH mul add SaY fc-smooth
    1 StormBaseDark sub mul StormBaseDark add mul
} bind def

% the rain under the base (the layer's RainMask): fades out toward the edge
% of the tower's foot, softly (StormRainSoft), in broad shafts streaked by a
% finer noise. The layer reads the rain where it left the base, StormRainSlant
% upwind per unit fallen (its RainDriftX, RainDriftZ), so x z here are
% already there and the whole curtain leans (#134: the mask alone leaned
% inside a straight column)
/fc-storm-rainmask {                             % x z -> 0..1
    /SrZ exch def /SrX exch def
    % the soft sides widen as the rain falls: right under the base the rain
    % stays inside the base's outline, so it doesn't stick out past the
    % cloud in a flat-topped block (#137), and flares out lower down
    StormRainSpread 0 gt { 0 StormRainSpread StormBase ClRainY sub fc-smooth } { 1 } ifelse
    StormRainSoft mul neg
    0.6 SrX StormBase 10 add SrZ fc-storm-env fc-smooth
    0.3 0.7 SrX 0.05 mul 17.3 add SrZ 0.05 mul 4.1 add fc-noise2 fc-smooth mul
    SrX 0.25 mul 2.9 add SrZ 0.25 mul 11.7 add fc-noise2 0.7 mul 0.3 add mul
    StormRainFine 0 gt {
        SrX 0.8 mul 5.3 add SrZ 0.8 mul 1.9 add fc-noise2 0.5 sub 2 mul StormRainFine mul 1 add 0 fc-max mul
    } if
} bind def

% --- the layer ------------------------------------------------------------------
% the storm's box: the envelope with room for the noise to push it out
/fc-storm-bounds {                               % - -> [x0 z0 x1 z1]
    /SbE 1 1 StormEdge div add def
    /SbT StormR StormFlare 1 add mul StormBulge 1 add mul StTopU add SbE mul def
    /SbU0 SbT neg StTopU AnvilR AnvilBack mul StRo add SbE mul sub fc-min def
    /SbU1 StTopU StRa SbE mul add SbT fc-max def
    /SbW AnvilR AnvilW mul StRo add SbE mul SbT fc-max def
    /SbX0 1e9 def /SbX1 -1e9 def /SbZ0 1e9 def /SbZ1 -1e9 def
    [ SbU0 SbW neg  SbU0 SbW  SbU1 SbW neg  SbU1 SbW ] /SbC exch def
    0 2 6 { /SbI exch def
        SbC SbI get StWc mul SbC SbI 1 add get StWs mul sub StCx add
        dup SbX0 lt { dup /SbX0 exch def } if dup SbX1 gt { dup /SbX1 exch def } if pop
        SbC SbI get StWs mul SbC SbI 1 add get StWc mul add StCz add
        dup SbZ0 lt { dup /SbZ0 exch def } if dup SbZ1 gt { dup /SbZ1 exch def } if pop
    } for
    [ SbX0 SbZ0 SbX1 SbZ1 ]
} bind def

/fc-storm-layer {                                % - -> dict
    << /Type /Cumulus
       /Lo StormBase /Hi StormTop DomeR 1.2 mul add 1 add
       /Profile [ 1000 1000 ] /ProfAmp 0     % the Shape makes the outline
       /Noise /Billow /Scale 0.05 /Stretch [ 1 0.8 1 ] /Threshold 0.36
       /CoverAmp 0 /Gain 12 /Sigma 0.12
       /DensOct 5 /ShadOct 3 /ShadStep 3 /Steps 110
       /AmbTop [ 0.40 0.44 0.53 ] /AmbBot [ 0.06 0.065 0.08 ]
       /Rain StormRain /RainDens StormRainDens /RainMask { fc-storm-rainmask }
       /RainDriftX StWc StormRainSlant mul /RainDriftZ StWs StormRainSlant mul
       /Shape { fc-storm-shape } /LightDepth { fc-storm-depth }
       /AmbShade { fc-storm-amb } /ShapeMul true
       /Bounds fc-storm-bounds /Probes 8   % 8: probes land in the anvil, so it shades the ground (#101)
    >>
    StormLayer { 2 index 3 1 roll put } forall
} bind def

/CloudLayers [ fc-storm-layer CloudLayers null ne { CloudLayers aload pop } if ] def

% --- gloom under the storm ------------------------------------------------------
% The air beneath the storm gets no sun, so its haze is dark: the part of the
% ray (up to the hit, LnT) inside a vertical column StormGloomR * StormR
% around the storm and below its base fades the pixel toward StormGloomCol,
% weighted by depth below the base and by closeness to the axis, so the
% column has no hard edge.
/fc-storm-gloom {                                % r g b -> r g b
    /SgA Mx dup mul Mz dup mul add def
    SgA 0.000001 gt {
        /SgB Mx StCx mul Mz StCz mul add def     % (half of -b)
        /SgC StCx dup mul StCz dup mul add StormGloomR StormR mul dup mul sub def
        SgB dup mul SgA SgC mul sub dup 0 gt {
            sqrt /SgD exch def
            /SgT0 SgB SgD sub SgA div 0 fc-max def
            /SgT1 SgB SgD add SgA div LnT fc-min def
            My 0.000001 gt { /SgT1 SgT1 StormBase CamY sub My div fc-min def } if
            My -0.000001 lt CamY StormBase gt and { /SgT0 SgT0 StormBase CamY sub My div fc-max def } if
            SgT1 SgT0 gt {
                % the shade thickens downward from the base (linear in height,
                % integrated along the ray) and toward the column's axis
                StormBase CamY sub SgT1 SgT0 sub mul
                My SgT1 dup mul SgT0 dup mul sub mul 2 div sub StormBase TerrBase sub div
                SgB dup mul SgA div SgC sub StormGloomR StormR mul dup mul div mul
                StormGloom mul neg 2.71828 exch exp /SgF exch def
                StormGloomCol 2 get 1 SgF sub mul exch SgF mul add 3 1 roll
                StormGloomCol 1 get 1 SgF sub mul exch SgF mul add 3 1 roll
                StormGloomCol 0 get 1 SgF sub mul exch SgF mul add 3 1 roll
            } if
        } { pop } ifelse
    } if
} bind def

StormGloom 0 gt {
    /FsGradeOrig /fc-landscape-grade load def
    /fc-landscape-grade { fc-storm-gloom FsGradeOrig } def
} if

% --- the sky the storm hides ----------------------------------------------------
% fc-cloud-sky probes straight up, so only the ground right under the storm
% lost its sky light; but a storm this size hides a broad part of the sky
% from the ground for miles round it. The ground loses up to StormSkyDim of
% its sky light, falling off as h^2 / (h^2 + d^2) with the plan distance d
% to the nearer of the tower's axis and the anvil's middle, h StormSkyR
% StormR (fc_terrain applies it through CloudSkyDim).
StormSkyDim 0 gt {
    /SsSkyOrig /fc-cloud-sky load def
    /SsH StormSkyR StormR mul dup mul def
    % the anvil's middle, half way out downwind
    /SsAx StCx StTopU AnvilR 0.5 mul add StWc mul add def
    /SsAz StCz StTopU AnvilR 0.5 mul add StWs mul add def
    /fc-cloud-sky {                              % x y z -> T
        3 copy SsSkyOrig /SsT exch def
        /SsZ exch def pop /SsX exch def
        SsX StCx sub dup mul SsZ StCz sub dup mul add
        SsX SsAx sub dup mul SsZ SsAz sub dup mul add fc-min
        SsH add SsH exch div StormSkyDim mul 1 exch sub SsT mul
    } def
} if

