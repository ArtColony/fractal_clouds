> def
/ClJI -1 def /ClJJ -1 def /ClJk 0 def
/fc-cloud-jitter {                               % - -> j
    /FrI where {
        pop
        FrI ClJI ne FrJ ClJJ ne or { /ClJI FrI def /ClJJ FrJ def /ClJk 0 def } { /ClJk ClJk 1 add def } ifelse
        ClBlue FrJ 63 and 64 mul FrI 63 and add get 0.5 add 256 div
        ClJk 0.618034 mul add dup floor sub
    } { fc-rnd } ifelse
} bind def

% 0..1 from the random stream (the erosion bake draws on it)
/fc-rnd { rand 2147483647 div } bind def
