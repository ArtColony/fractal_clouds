%!PS-Adobe-3.0
% fc_landscape.ps -- a whole landscape scene: sky, clouds, terrain,
% erosion and (optionally) forest, behind one general fc-pixel
% (fractal_clouds#11).
%
% A piece sets its options, then loads only this file, which loads the
% others in the order they need:
%
%   /Seed where { pop } { /Seed 5 def } ifelse     % ...and any other settings
%   (lib/fc_landscape.ps) run
%   320 200 fc-landscape
%   showpage
%
%   fc-landscape-setup -     seed the noise, bake erosion (and the forest),
%                            place the camera; fc-landscape calls it if the
%                            piece hasn't (call it yourself to change
%                            something afterwards, such as CamY)
%   pw ph fc-landscape -     set up if needed, then fc-render the page
%
% Options this file owns (docs/settings.md lists every library's):
%   Seed      5      one number seeds everything
%   TreesOn   false  load lib/fc_trees.ps and march the forest; also turns
%                    fc_terrain's painted forest off (TreeLine -1000)
%   Erode     true   bake droplet erosion over the view (fc_erode.ps)
%   CamLift   0      if > 0: camera at this fraction of the tallest peaks,
%                    but at least CamAbove over the ground below it
%   CamAbove  6      otherwise: camera this far above the ground below it
%   CamHeight null   a number puts the camera at exactly that height
%   Profile   false  count calls and time the main procedures, and print a
%                    table after fc-render (lib/fc_bench.ps)
%   WaterY    null   a number: a lake (or sea) surface at that height
%   WaterRise null   a number: the lake this far above the ground under the
%                    camera (sets WaterY during setup)
%   Rivers    false  carve rivers along the erosion's flow and fill them
%                    (needs Erode)
%   MapWater  false  fill the lakes of a terrain map (MapOn, fc_map.ps) at
%                    their levels. Any of these four loads lib/fc_water.ps,
%                    which wraps the hit and surface hooks below
%   StandAt   null   [x z] in map (terrain) coordinates: stand the camera
%                    there (sets TerrOX TerrOZ, overriding the piece's)
%   LookAt    null   [x z] or [x y z]: aim the camera at that map point
%                    (sets Yaw as this file loads, and Pitch during setup,
%                    once the camera height and the ground there are known;
%                    without y, the ground at x z, or WaterY / MapSea where
%                    higher; a map lake's level isn't used: give y)
%   LookTilt  0      degrees added to the Pitch LookAt works out (positive
%                    tilts the view up, lowering the target in the frame)
%   BakeCache false  keep the erosion and forest bakes in renders/cache/ and
%                    read them back (lib/fc_cache.ps)
%   Pass      /beauty  /mask, /depth, /material or /matte: draw that render
%                    pass instead of the picture (lib/fc_passes.ps)
%   PassKeep  []     passes to record for drawing again (fc-pass-draw)
%
% Hooks: fc-pixel calls these by name, so a piece can redefine any of them
% after loading (each one's default is below):
%
%   fc-landscape-hit      - -> t | -1    nearest surface along the ray
%   fc-landscape-surface  t -> r g b     its colour, linear light, before haze
%   fc-landscape-sky      dx dy dz -> r g b   what a ray that hits nothing sees
%   fc-landscape-grade    r g b -> r g b      last change before fc-tone;
%                         fc-grade (lib/fc_grade.ps) when a piece sets
%                         GradeTemp, GradeSat, GradeSplit, GradeLift or
%                         Vignette, else nothing
%
% While a pixel is shaded, Mx My Mz is its unit ray (from (0, CamY, 0));
% after the surface and sky, LnT is the hit distance (TMax for sky) and
% LnR LnG LnB the colour before clouds. A piece can also write its own
% /fc-pixel from these parts.

% --- where the camera stands and what it aims at (#23) -----------------------
% StandAt and LookAt are map points. The offsets and the yaw are set here,
% before any library reads them (fc_sky's camera, the erosion and forest
% windows, which lie along Yaw); the pitch needs heights, so setup sets it.
/StandAt where { pop } { /StandAt null def } ifelse
/LookAt where { pop } { /LookAt null def } ifelse
/LookTilt where { pop } { /LookTilt 0 def } ifelse
StandAt null ne { /TerrOX StandAt 0 get def /TerrOZ StandAt 1 get def } if
/LnLkOn false def
LookAt null ne {
    /LnLkX LookAt 0 get /TerrOX where { pop TerrOX } { 0 } ifelse sub def
    /LnLkZ LookAt LookAt length 1 sub get /TerrOZ where { pop TerrOZ } { 0 } ifelse sub def
    /LnLkD LnLkX dup mul LnLkZ dup mul add sqrt def
    LnLkD 1e-6 gt {
        /LnLkOn true def
        /Yaw LnLkX LnLkZ atan dup 180 gt { 360 sub } if def
    } { (fc_landscape: LookAt is where the camera stands; Yaw and Pitch left alone\n) print } ifelse
} if

(lib/fc_sky.ps) run
(lib/fc_noise2.ps) run (lib/fc_noise3.ps) run
(lib/fc_clouds.ps) run

/Seed 5 fc-default
/TreesOn false fc-default
/Erode true fc-default
/CamLift 0 fc-default
/CamAbove 6 fc-default
/CamHeight null fc-default
/Profile false fc-default
/WaterY null fc-default
/WaterRise null fc-default
/Rivers false fc-default
/MapWater false fc-default
TreesOn { /TreeLine -1000 fc-default } if     % fc_trees paints the forest

(lib/fc_terrain.ps) run
(lib/fc_render.ps) run
(lib/fc_erode.ps) run
(lib/fc_cache.ps) run
TreesOn { (lib/fc_trees.ps) run } if
Profile { (lib/fc_bench.ps) run } if

/LnSetUp false def
/fc-landscape-setup {
    Profile { fc-bench-wrap } if
    % the order matters: erosion's droplets draw from the march seed
    Seed fc-noise2-init
    Seed 101 add fc-noise3-init
    WaterRise null ne { /WaterY 0 0 TerrOct fc-height-proc WaterRise add def } if
    TreesOn { Seed 303 add fc-trees-init } if
    Seed 202 add srand
    % the bakes go through fc_cache.ps, which (with BakeCache on) reads
    % them back from renders/cache/ when their inputs haven't changed;
    % the rivers carve the erosion map, so they belong to its bake
    Erode { (erode) { fc-erode-bake Rivers { fc-water-rivers } if } fc-cache-run } {
        Rivers { (fc_landscape: Rivers needs Erode\n) print } if
    } ifelse
    TreesOn { (forest) { fc-forest-bake } fc-cache-run } if
    CamHeight null ne { /CamY CamHeight def } {
        0 0 TerrOct fc-height CamAbove add
        CamLift 0 gt { TerrTop CamLift mul exch fc-max } if
        /CamY exch def
    } ifelse
    LnLkOn {
        % pitch to the target: its own y, or the ground there, or the
        % water over it (WaterY, or a map's sea MapSea) where that is higher
        LookAt length 3 ge { LookAt 1 get } {
            LnLkX LnLkZ TerrOct fc-height
            WaterY null ne { WaterY fc-max } if
            /MapSea where { pop MapSea null ne { MapSea fc-max } if } if
        } ifelse
        CamY sub LnLkD atan dup 180 gt { 360 sub } if LookTilt add /Pitch exch def
        fc-camera-update
        LnGrade { fc-grade-update } if
    } if
    /LnSetUp true def
} bind def

% --- hooks -----------------------------------------------------------------
/fc-landscape-hit { TreesOn { fc-forest-hit } { fc-terrain-hit } ifelse } bind def

/fc-landscape-surface {                          % t -> r g b
    TreesOn { FsMat 1 eq } { false } ifelse { fc-tree-shade } { fc-terrain-shade } ifelse
} bind def

/fc-landscape-sky {                              % dx dy dz -> r g b
    1 index 0 lt { pop pop pop HazeCol aload pop } { fc-sky } ifelse
} bind def

/fc-landscape-grade { } def                      % r g b -> r g b

% a colour grade (lib/fc_grade.ps) if any of its settings is away from
% neutral; otherwise the hook stays empty
/LnGrade false def
[ /GradeTemp 0 /GradeSat 1 /GradeSplit 0 /GradeLift 0 /Vignette 0 ] aload pop
5 { exch dup where { exch get ne { /LnGrade true def } if } { pop pop } ifelse } repeat
LnGrade {
    (lib/fc_grade.ps) run
    /fc-landscape-grade { fc-grade } bind def
} if

% --- the pixel ---------------------------------------------------------------
/fc-landscape-pixel {                            % u v -> r g b
    fc-ray /Mz exch def /My exch def /Mx exch def
    Mx Mz fc-haze-colour
    fc-landscape-hit dup 0 gt {
        /LnT exch def /FcKey LnT def
        LnT fc-landscape-surface LnT fc-haze
    } {
        pop /LnT TMax def
        Mx My Mz fc-landscape-sky
    } ifelse
    /LnB exch def /LnG exch def /LnR exch def
    LnT fc-clouds
    Cr LnR Tr mul add  Cg LnG Tr mul add  Cb LnB Tr mul add
    fc-landscape-grade
    fc-tone
} bind def

/fc-pixel { fc-landscape-pixel } bind def

% water wraps the hooks above, so it loads after them
WaterY null ne WaterRise null ne or Rivers or MapWater or { (lib/fc_water.ps) run } if

% render passes (#33) wrap fc-pixel and fc-render, so they load last
/Pass /beauty fc-default
/PassKeep [] fc-default
Pass /beauty ne PassKeep length 0 gt or { (lib/fc_passes.ps) run } if

/fc-landscape {                                  % pw ph -> -
    LnSetUp not { fc-landscape-setup } if
    Profile { fc-bench-wrap fc-bench-mark } if      % again: the piece's hooks are in by now
    fc-render
    Profile { fc-bench-report } if
} bind def
