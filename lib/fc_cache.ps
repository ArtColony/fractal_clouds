%!PS-Adobe-3.0
% fc_cache.ps -- keep the erosion and forest bakes on disk and read them
% back when nothing they depend on has changed (fractal_clouds#18).
%
% Needs fc_render.ps (fc-default). fc_landscape.ps loads it and runs its
% bakes through it:
%
%   (name) proc fc-cache-run -   run proc, a bake, through the cache: with
%                                BakeCache off (the default) it just runs
%                                proc; with it on, it reads the bake's
%                                result back from renders/cache/ if a file
%                                with the same key is there, and otherwise
%                                runs proc and prints the result for
%                                scripts/render.sh to file
%
% pscat 0.6.2 can't write files (docs/pscat-issues.md #15), so the cache is
% written through stdout: a miss prints a block between %%FcCacheBegin and
% %%FcCacheEnd lines, and render.sh cuts it out of the log into
% renders/cache/<name>-<key>.ps, by a temporary file and a rename, so bands
% rendering in parallel never see half a file. A cache file is PostScript:
% each name the bake defined or changed, with its value at full precision
% (pscat's cvs round-trips reals exactly), so a hit reads it back with
% `run`, which at ErN 1024 takes about 0.2 s for a 20 MB file.
%
% The key is everything a bake can read, at the moment it starts:
%   - every entry of userdict, then of the current dictionary if a piece
%     has begun its own, procedures included (operators by name); numbers
%     inside arrays over 64 entries count to 1e-9, and an array or dict an
%     earlier cached bake made counts as that bake's key (so the forest's
%     key doesn't hash the erosion map). Left out: the names in ZcSkip
%     (render-only settings such as Crop, Res and PixSeed, so the bands of
%     one frame and its probe share the bake), BakeCacheSkip, and usertime
%     stamps (names like EbT0 or FsT1);
%   - the random stream's state (rrand): a bake draws from it;
%   - FcCacheSrc, a hash of the source (lib/*.ps, the piece, the pinned
%     pscat version and the installed one) that render.sh defines when the cache is on. Without
%     it nothing is cached: the file couldn't be written anyway.
% A miss records every name whose value the bake changed (not eq before
% and after, or of another type), temporaries included, and the stream's
% state afterwards. A hit puts all of them back and srand's the stream to
% that state, so what follows (the next bake's key, the render) sees
% exactly what it would after a real bake, and the picture is the same
% byte for byte. What can't be recorded that way is not cached, with a
% "can't keep" line in the log: an array or dict the bake changed in place
% (its hash in the key differs afterwards), a name it removed, or an array
% that appears twice inside what it made. The erosion and forest bakes do
% none of these. Two in-place changes go unnoticed: to a string, and to an
% array or dict an earlier cached bake made (ZcMade, which the key counts by
% that bake's key, not its contents).
%
% Settings:
%   BakeCache       false  read and write renders/cache/ (render.sh
%                          -D BakeCache=true, or BAKE_CACHE=1; on by
%                          default in render_bands.sh)
%   BakeCacheSkip   []     more names to leave out of the key (settings
%                          only the render reads)
%   BakeCacheDebug  false  print every key entry's hash (%%FcKey lines), to
%                          find what makes two runs miss
%
% Temporaries use the Zc prefix.

/BakeCache false fc-default
/BakeCacheSkip [] fc-default
/BakeCacheDebug false fc-default

% render-only names that don't reach the bakes, left out of the key
% (pscat --bands defines BandIndex, BandCount and BandBBox per band: keyed,
% every band but one would miss and bake again)
/ZcSkip 32 dict def
[ /Crop /Res /PixSeed /RowTimes /AA /FrameGrid /FrameLabel /Pass /PassKeep
  /Profile /BakeCache /BakeCacheSkip /BakeCacheDebug /FcCacheSrc /LnSetUp
  /BandIndex /BandCount /BandBBox ]
{ ZcSkip exch true put } forall

/ZcP1 2147483629 def /ZcP2 2147483587 def
/ZcBuf 256 string def

% --- hashing -----------------------------------------------------------------
% two 31-bit polynomial hashes side by side, h1 h2 on the operand stack (no
% names, so a value can hash its parts recursively)
/fc-cache-mix {                                  % h1 h2 v -> h1' h2'  (v an integer >= 0)
    exch 137 mul 1 index add ZcP2 mod
    3 1 roll exch 131 mul add ZcP1 mod exch
} bind def
/fc-cache-hs { { fc-cache-mix } forall } bind def          % h1 h2 string -> h1' h2'
/fc-cache-ht { 0 get fc-cache-mix } bind def               % h1 h2 (t) -> h1' h2'
/fc-cache-tag { exch 4 1 roll fc-cache-ht 3 -1 roll } bind def   % h1 h2 v (t) -> h1' h2' v

% operators by name (cvs gives --nostringval--)
/ZcOps 512 dict def
systemdict { dup type /operatortype eq { ZcOps exch 3 -1 roll put } { pop pop } ifelse } forall
% a number in a long array: integers as they are, reals to 1e-9 (cvs and a
% character loop per number would take seconds over a large map)
/fc-cache-hn {                                   % h1 h2 v -> h1' h2'
    dup type /integertype eq { ZcP1 mod ZcP1 add fc-cache-mix } {
        dup abs 1e9 lt { 1e9 mul round cvi ZcP1 mod ZcP1 add fc-cache-mix }
            { ZcBuf cvs fc-cache-hs } ifelse
    } ifelse
} bind def
/fc-cache-hel {                                  % h1 h2 v -> h1' h2'  (an element of a long array)
    dup type dup /integertype eq exch /realtype eq or { fc-cache-hn } { fc-cache-hv } ifelse
} bind def

/ZcHv <<
    /integertype { (i) fc-cache-tag ZcBuf cvs fc-cache-hs }
    /realtype    { (r) fc-cache-tag ZcBuf cvs fc-cache-hs }
    /booleantype { { (T) } { (F) } ifelse fc-cache-ht }
    /nulltype    { pop (N) fc-cache-ht }
    /nametype    { dup xcheck { (x) } { (n) } ifelse fc-cache-tag ZcBuf cvs fc-cache-hs }
    /stringtype  { (s) fc-cache-tag 3 1 roll 2 index length fc-cache-mix 3 -1 roll fc-cache-hs }
    /arraytype   {
        % procedures too: a piece's own or a -D one isn't in FcCacheSrc
        dup xcheck { (p) } { (a) } ifelse fc-cache-tag
        3 1 roll 2 index length fc-cache-mix 3 -1 roll
        dup length 64 gt { { fc-cache-hel } forall } { { fc-cache-hv } forall } ifelse }
    /dicttype    { fc-cache-hd }
    /operatortype { ZcOps 1 index known { ZcOps exch get } { pop /op } ifelse
        (O) fc-cache-tag ZcBuf cvs fc-cache-hs }
>> def
ZcHv /packedarraytype ZcHv /arraytype get put
/fc-cache-hv {                                   % h1 h2 value -> h1' h2'
    ZcHv 1 index type 2 copy known { get exec } {
        pop pop type ZcBuf cvs (o) fc-cache-tag fc-cache-hs   % operators, files...: their type
    } ifelse
} bind def

% a dict: the sum of its entries' hashes, so the order forall visits them in
% doesn't matter; three levels deep at most, and not fonts or the system dicts
/ZcDepth 0 def
/fc-cache-hd {                                   % h1 h2 dict -> h1' h2'
    dup /FontType known 1 index userdict eq or 1 index systemdict eq or ZcDepth 3 ge or {
        (D) fc-cache-tag length fc-cache-mix
    } {
        /ZcDepth ZcDepth 1 add def
        (d) fc-cache-tag
        0 0 3 -1 roll { fc-cache-he fc-cache-add } forall    % h1 h2 s1 s2
        4 2 roll 3 index fc-cache-mix 2 index fc-cache-mix 4 2 roll pop pop
        /ZcDepth ZcDepth 1 sub def
    } ifelse
} bind def
/fc-cache-he {                                   % k v -> e1 e2  (one entry)
    exch 7 11 3 -1 roll fc-cache-hv (=) fc-cache-ht 3 -1 roll fc-cache-hv
} bind def
/fc-cache-add {                                  % s1 s2 e1 e2 -> s1' s2'
    3 -1 roll add ZcP2 mod 3 1 roll add ZcP1 mod exch
} bind def

% does a top-level name stay out of the key (and out of what a bake records)?
/fc-cache-skip? {                                % key -> bool
    dup ZcSkip exch known { pop true } {
        false BakeCacheSkip { 2 index eq or } forall
        { pop true } {
            ZcBuf cvs
            % Zc: this file's own; Bn: fc_bench's counters
            dup length 2 ge { dup 0 2 getinterval dup (Zc) eq exch (Bn) eq or } { false } ifelse
            % usertime stamps: two letters, T, a digit (EbT0, FsT0, AqT0 ...)
            1 index length 4 eq {
                1 index 2 get 84 eq 2 index 3 get dup 48 ge exch 57 le and and or
            } if
            exch pop
        } ifelse
    } ifelse
} bind def

/fc-cache-hex8 {                                 % n -> (8 hex digits)
    16 8 string cvrs (00000000) 8 string copy dup 3 -1 roll dup length 8 exch sub exch putinterval
} bind def

% Arrays and dicts a cached bake made (or read back) earlier in this run,
% by name: [ object key ]. The key they came from stands for them in a later
% bake's key, so the forest's key doesn't hash the erosion map.
/ZcMade 64 dict def
/fc-cache-made {                                 % name value -> -   (record it if it is an array or dict)
    dup type dup /arraytype eq exch /dicttype eq or { [ exch ZcKey ] ZcMade 3 1 roll put } { pop pop } ifelse
} bind def

% The key. Each dictionary (userdict, then the current one if a piece has
% begun its own) is hashed as the sum of its entries' hashes, the sums one
% after the other, so a name's dictionary counts. ZcEh keeps each array and
% dict entry's hash, to check afterwards that the bake left it alone.
/fc-cache-key {                                  % (name) -> (key)
    /ZcNm exch def /ZcEh 1024 dict def
    7 11
    [ userdict currentdict userdict eq { } { currentdict } ifelse ] {
        0 0 3 -1 roll {                          % h1 h2 s1 s2 k v
            1 index fc-cache-skip? { pop pop } {
                1 index ZcMade exch known { ZcMade 2 index get 0 get 1 index eq } { false } ifelse
                { pop ZcMade 1 index get 1 get } if
                2 copy fc-cache-he                   % k v e1 e2
                2 index type dup /arraytype eq exch /dicttype eq or { ZcEh 4 index 3 index put } if
                BakeCacheDebug { (%%FcKey ) print 3 index ZcBuf cvs print ( ) print
                    1 index ZcBuf cvs print ( ) print dup ZcBuf cvs print (\n) print } if
                4 2 roll pop pop
                fc-cache-add
            } ifelse
        } forall
        4 2 roll 3 index fc-cache-mix 2 index fc-cache-mix 4 2 roll pop pop
    } forall
    ZcNm fc-cache-hs
    rrand fc-cache-mix
    FcCacheSrc fc-cache-hs
    exch fc-cache-hex8 exch fc-cache-hex8
    16 string dup 0 4 -1 roll putinterval dup 8 4 -1 roll putinterval
} bind def

% --- writing ------------------------------------------------------------------
% through a 64 KB buffer: print per number makes a system call each
/ZcOb 65536 string def /ZcOp 0 def
/fc-cache-flush { ZcOb 0 ZcOp getinterval print (\n) print /ZcOp 0 def } bind def
% fc-cache-emit ends a token and flushes after one once the buffer is past
% 60000; fc-cache-emit2 writes part of a token (a name's slash, a hex
% string's digits) and flushes only if it would overflow, which only a hex
% string over 5 KB can make it do (a line break inside one is harmless)
/fc-cache-emit {                                 % string -> -   (and a space)
    dup length ZcOp add 65534 gt { fc-cache-flush } if
    dup length exch ZcOb exch ZcOp exch putinterval ZcOp add
    dup ZcOb exch 32 put 1 add /ZcOp exch def
    ZcOp 60000 gt { fc-cache-flush } if
} bind def
/fc-cache-emit2 { dup length ZcOp add 65534 gt { fc-cache-flush } if   % string -> -  (no space)
    dup length exch ZcOb exch ZcOp exch putinterval ZcOp add /ZcOp exch def } bind def

% Where else the object is, among the values from before the bake (ZcSnap,
% which a cache file reaches as ZcPre: the dictionary it is read into the
% state of, which on a hit is the same as before the bake): a name whose
% value is this very object, or, for a procedure a bake installs from a
% literal inside another procedure (as fc_coast's material hook does), the
% path to it inside one. Leaves the name, or null, and the path in ZcPth
% (ZcPn indices, innermost first).
/ZcPth 8 array def /ZcPn 0 def
/fc-cache-alias {                                % obj -> name | null
    /ZcAo exch def /ZcAn null def /ZcPn 0 def
    ZcSnap {
        dup type /ZcAo load type eq { /ZcAo load eq } { pop false } ifelse {
            dup fc-cache-skip? { pop } { /ZcAn exch def exit } ifelse
        } { pop } ifelse
    } forall
    ZcAn null eq /ZcAo load xcheck and {
        ZcSnap {
            dup type dup /arraytype eq exch /packedarraytype eq or 2 index fc-cache-skip? not and {
                /ZcPn 0 def 0 fc-cache-in { /ZcAn exch def exit } { pop } ifelse
            } { pop pop } ifelse
        } forall
    } if
    ZcAn
} bind def

% is ZcAo inside arr (at most 6 levels down)? on true, ZcPth holds the path
/fc-cache-in {                                   % arr depth -> bool
    1 add exch false exch                        % d false arr
    0 1 2 index length 1 sub {                   % d false arr i
        2 copy get                               % d false arr i e
        dup /ZcAo load eq 1 index type /ZcAo load type eq and {
            pop ZcPth ZcPn 3 -1 roll put /ZcPn ZcPn 1 add def
            exch pop true exch exit
        } {
            dup type dup /arraytype eq exch /packedarraytype eq or 5 index 6 lt and {
                4 index fc-cache-in {
                    ZcPth ZcPn 3 -1 roll put /ZcPn ZcPn 1 add def
                    exch pop true exch exit
                } { pop } ifelse
            } { pop pop } ifelse
        } ifelse
    } for
    pop exch pop
} bind def

% write a name fc-cache-alias found, with its path
/fc-cache-emit-alias {                           % name -> -
    (ZcPre) fc-cache-emit (/) fc-cache-emit2 ZcBuf cvs fc-cache-emit (get) fc-cache-emit
    ZcPn 1 sub -1 0 { ZcPth exch get ZcBuf cvs fc-cache-emit (get) fc-cache-emit } for
} bind def

/fc-cache-ev {                                   % value -> -  (as PostScript text)
    dup type
    dup /integertype eq 1 index /realtype eq or 1 index /booleantype eq or {
        pop ZcBuf cvs fc-cache-emit } {
    dup /nulltype eq { pop pop (null) fc-cache-emit } {
    dup /nametype eq { pop dup xcheck { (/) fc-cache-emit2 ZcBuf cvs fc-cache-emit2 ( cvx) fc-cache-emit }
        { (/) fc-cache-emit2 ZcBuf cvs fc-cache-emit } ifelse } {
    dup /stringtype eq { pop (<) fc-cache-emit2
        { 256 add 16 3 string cvrs 1 2 getinterval fc-cache-emit2 } forall (>) fc-cache-emit } {
    dup /arraytype eq 1 index /packedarraytype eq or 1 index /dicttype eq or {
        pop dup fc-cache-alias dup null ne {
            exch pop fc-cache-emit-alias
        } { pop
            ZcSeen 1 index known { /ZcFail true def /ZcFailN ZcEn def } { ZcSeen 1 index true put } ifelse
            dup type /dicttype eq { (<<) fc-cache-emit { exch fc-cache-ev fc-cache-ev } forall (>>) fc-cache-emit } {
            dup xcheck { pop /ZcFail true def /ZcFailN ZcEn def (null) fc-cache-emit } {
                ([) fc-cache-emit { fc-cache-ev } forall (]) fc-cache-emit
            } ifelse } ifelse
        } ifelse } {
    pop pop /ZcFail true def /ZcFailN ZcEn def (null) fc-cache-emit
    } ifelse } ifelse } ifelse } ifelse } ifelse
} bind def

% --- the cache ---------------------------------------------------------------
/fc-cache-run {                                  % (name) proc -> -
    BakeCache /FcCacheSrc where { pop FcCacheSrc type /stringtype eq } { false } ifelse and not {
        % off: just the bake, defining nothing
        BakeCache { (fc-cache: no FcCacheSrc (render with scripts/render.sh); baking\n) print } if
        exch pop exec
    } { currentdict userdict ne {
        % the key and the record of changes cover userdict only
        exch (fc-cache: ) print print ( can't keep it: the current dictionary isn't userdict\n) print exec
    } {
    /ZcPr exch def /ZcName exch def
        /ZcT0 realtime def
        ZcName fc-cache-key /ZcKey exch def
        /ZcFile 128 string def
        ZcFile 0 (renders/cache/) putinterval
        ZcFile 14 ZcName putinterval
        ZcFile 14 ZcName length add (-) putinterval
        ZcFile 15 ZcName length add ZcKey putinterval
        ZcFile 31 ZcName length add (.ps) putinterval
        /ZcFile ZcFile 0 34 ZcName length add getinterval def
        % read it back, into a dict of its own first
        /ZcD 256 dict def /ZcCds countdictstack def
        /ZcPre currentdict def
        mark { ZcD begin ZcFile run end } stopped
        countdictstack ZcCds sub { end } repeat
        cleartomark
        ZcD /ZcOK known { ZcD /ZcKey get ZcKey eq } { false } ifelse {
            /ZcDst currentdict def
            ZcD { 1 index fc-cache-skip? { pop pop } { 2 copy fc-cache-made ZcDst 3 1 roll put } ifelse } forall
            ZcD /ZcRand get srand
            (fc-cache: ) print ZcName print ( hit ) print ZcKey print ( ms ) print
            realtime ZcT0 sub ZcBuf cvs print (\n) print
        } {
            (fc-cache: ) print ZcName print ( miss ) print ZcKey print (\n) print
            /ZcSnap currentdict dup length 16 add dict copy def
            ZcPr
            /ZcT1 realtime def
            % what the bake changed
            /ZcCh 256 dict def
            currentdict { 1 index fc-cache-skip? { pop pop } {
                ZcSnap 2 index known {
                    ZcSnap 2 index get 2 copy eq 3 1 roll type exch type eq and
                    { pop } { ZcCh exch true put } ifelse
                } { pop ZcCh exch true put } ifelse
            } ifelse } forall
            /ZcFail false def
            % an array or dict the bake changed in place, or a name it took
            % away, can't be written as a change: don't cache
            ZcEh { 1 index ZcCh exch known { pop pop } {
                exch dup where { pop dup load 1 index exch fc-cache-he pop 3 -1 roll ne
                    { /ZcFailN exch def /ZcFail true def } { pop } ifelse }
                  { /ZcFailN exch def pop /ZcFail true def } ifelse
            } ifelse } forall
            ZcSnap { pop dup fc-cache-skip? { pop } { dup where { pop pop }
                { /ZcFailN exch def /ZcFail true def } ifelse } ifelse } forall
            (\n%%FcCacheBegin ) print ZcName print (-) print ZcKey print (\n) print
            (%!PS-Adobe-3.0 fc_cache: the ) print ZcName print ( bake \(fractal_clouds#18\)\n) print
            (/ZcKey \() print ZcKey print (\) def\n) print
            /ZcDone 64 dict def /ZcSeen 1024 dict def
            ZcCh { pop
                currentdict 1 index get fc-cache-alias-changed
            } forall
            (/ZcRand ) print rrand ZcBuf cvs print ( def\n) print
            ZcFail {
                (\n%%FcCacheAbort\nfc-cache: ) print ZcName print ( can't keep ) print ZcFailN ZcBuf cvs print (; not cached\n) print
            } {
                (/ZcOK true def\n%%FcCacheEnd ) print ZcName print (-) print ZcKey print (\n) print
                (fc-cache: ) print ZcName print ( written ms ) print realtime ZcT1 sub ZcBuf cvs print (\n) print
            } ifelse
            ZcFail not { ZcCh { pop dup load fc-cache-made } forall } if
            /ZcCh null def /ZcDone null def /ZcSnap null def /ZcSeen null def /ZcEh null def
        } ifelse
        /ZcD null def
    } ifelse } ifelse
} bind def

% one changed entry: name value -> -
/fc-cache-alias-changed {
    exch /ZcEn exch def /ZcEv exch def
    % the same object as a changed name already written: point at it
    /ZcEa null def
    /ZcEv load type dup /arraytype eq exch /dicttype eq or {
        ZcDone { /ZcEv load eq { /ZcEa exch def exit } { pop } ifelse } forall
    } if
    (/) fc-cache-emit2 ZcEn ZcBuf cvs fc-cache-emit
    ZcEa null ne { (/) fc-cache-emit2 ZcEa ZcBuf cvs fc-cache-emit2 ( load) fc-cache-emit }
        { /ZcEv load fc-cache-ev } ifelse
    (def) fc-cache-emit fc-cache-flush
    /ZcEv load type dup /arraytype eq exch /dicttype eq or { ZcDone ZcEn /ZcEv load put } if
} bind def
