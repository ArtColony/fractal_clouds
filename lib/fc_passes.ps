%!PS-Adobe-3.0
% fc_passes.ps -- render passes, for landscapes used inside larger works
% (fractal_clouds#33). fc_landscape.ps loads this file last when Pass is not
% /beauty or PassKeep names a pass, so a piece needs no line of its own.
%
% Pass picks what the page's image shows; every pass but the beauty is
% written as is, without the colour grade or fc-tone:
%
%   /beauty    the picture, as without this file (loaded for PassKeep)
%   /mask      coverage: 1 (white) where the landscape is, 0 (black) on open
%              sky; clouds over the sky count by their opacity, 1 - Tr, unless
%              MaskClouds is false. Antialiased edges come out soft (an alpha)
%   /depth     1 - t / DepthFar, clamped: white near, black at DepthFar and
%              on the sky (t, the hit distance, is what FcKey holds)
%   /material  a flat colour per material, from the palette below (the
%              material with the largest share of the pixel; AA is turned
%              off, so every pixel is exactly one of the eight colours)
%   /matte     one material's share of the pixel, 0..1 (PassMat names it):
%              soft where materials blend (snow over rock, a cloud's edge)
%
%   ID  name     colour (sRGB)        what
%   0   sky      0 0 0     black      rays that hit nothing
%   1   cloud    255 255 255 white    the clouds in front, by their opacity
%   2   rock     214 39 40  red       bare ground: rock, scree, strata
%   3   snow     102 224 255 cyan     fc_terrain's snow (Ksnow)
%   4   forest   44 160 44  green     fc_terrain's painted forest (Kfor) and
%                                     fc_trees' trees (FsMat 1), far canopy
%                                     (Ftc) and forest floor (Ftn)
%   5   water    31 79 216  blue      lakes, rivers, the sea (fc_water's AqWet)
%   6   sand     242 200 75 yellow    fc_coast's beaches, fc_ocean's sand
%   7   grass    166 216 84 lime      fc_trees' grass and meadow (Ftg)
%
% A pixel's shares, read from what the shading left behind: no hit is sky;
% else water if fc_water hit water, else forest if fc_trees hit a tree,
% else the ground, top down as the hooks paint it: sand S (fc_coast's
% XcMw, fc_ocean's OcSd); forest for fc_trees' needle litter (Ftn, as it
% ends up: roughly) and far canopy (Ftc); grass (Ftg); then of the rest R,
% snow R Ksnow, forest R (1 - Ksnow) Kfor, rock what is left. Each is
% scaled by the clouds' transmittance Tr, and the cloud gets 1 - Tr.
%
% Settings:
%   Pass        /beauty  what the image shows (above)
%   PassMat     /snow    the material /matte shows (a name from the table)
%   PassKeep    []       passes to record while the image renders, any of
%                        /beauty /mask /depth /material, for fc-pass-draw
%                        and the clips below (one byte a pixel, three for
%                        the beauty; the centre sample, so no AA, except
%                        the beauty when Pass is /beauty: its finished rows)
%   MaskClouds  true     clouds over the sky count in the mask
%   DepthFar    null     the distance /depth reaches black at; null: TMax
%   PassSoft    true     with PassKeep, keep what fc-behind and fc-land-draw
%                        need for a soft edge: the mask from every sample
%                        (antialiased), and the landscape's own colour and
%                        what is behind it (three bytes a pixel each), and
%                        the compositing alpha (one). Needs pscat
%                        0.7.0-rc.4+ (ImageType 3, setalpha on images); without
%                        them, or false, the hard clips, as before #87
%
% With PassKeep, one march gives a page the picture and its passes:
%
%   pw ph fc-landscape-keep -   render and record, but paint nothing (on
%                               the nulldevice; an empty clip on an older
%                               pscat or in a --bands band)
%   /name fc-pass-draw -        paint a kept pass over 0 0 pw ph of the
%                               current user space (as fc-landscape would)
%   proc fc-behind -            the picture with proc's art behind the
%                               landscape: the sky, the art, then the
%                               landscape over it, soft-edged
%   fc-land-draw -              the landscape alone over what is on the
%                               page, soft-edged (an alpha on --transparent)
%   fc-sky-draw -               what is behind the landscape, opaque
%   fc-sky-clip -               intersect the clip with the kept mask's sky
%   fc-land-clip -              ... or with the landscape (mask >= 0.5)
%
% fc-behind and fc-land-draw paint the landscape's own colour (straight, so
% no sky-coloured fringe) at its coverage, in layers through 1-bit masks
% (below). Without PassSoft they fall back to the clips: art drawn after
% `fc-sky-clip` sits behind the mountains, and a beauty drawn after
% `fc-land-clip` leaves the sky to what was drawn before (or to a
% transparent page: pscat --transparent), hard-edged, one landscape pixel
% per step.
%
% /mask and /depth march the hit only (and the clouds, for the mask): no
% shading, so they cost a fraction of the beauty. A piece that redefines
% /fc-pixel itself bypasses this file; one that redefines the hooks
% (fc-landscape-hit, -surface, -sky) keeps working. With Crop, the kept
% passes outside the crop stay zero: sky in the mask and IDs, black in the
% beauty and depth.
%
% Names: this file keeps its temporaries under Ps*.

% (Pass and PassKeep default in fc_landscape.ps, which decides to load this)
/PassMat /snow fc-default
/MaskClouds true fc-default
/DepthFar null fc-default
/PassSoft true fc-default

% Soft compositing needs pscat 0.7.0-rc.4 or later: ImageType 3 masked
% images and nulldevice (pscat#758), and setalpha applied to images
% (pscat#830). The probe below finds the first two and that setalpha
% exists, so an older pscat (or Ghostscript) falls back to the hard clips.
% It can't tell whether setalpha reaches images: PostScript can't read
% pixels back, and pscat has no version operator. A build that has #758
% but not #830 would paint every level opaque; use
% PassSoft false there
/PsSoftOK systemdict /setalpha known {
    gsave mark {
        nulldevice /DeviceRGB setcolorspace
        << /ImageType 3 /InterleaveType 3
           /DataDict << /ImageType 1 /Width 1 /Height 1 /BitsPerComponent 8 /Decode [0 1 0 1 0 1]
                        /ImageMatrix [1 0 0 1 0 0] /DataSource <000000> >>
           /MaskDict << /ImageType 1 /Width 1 /Height 1 /BitsPerComponent 1 /Decode [1 0]
                        /ImageMatrix [1 0 0 1 0 0] /DataSource <80> >> >> image
    } stopped { cleartomark false } { cleartomark true } ifelse
    grestore
} { false } ifelse def
PassSoft PsSoftOK not and PassKeep length 0 gt and {
    (fc_passes: soft compositing needs pscat 0.7.0-rc.4 or later \(ImageType 3, nulldevice, setalpha on images\); fc-land-draw and fc-behind use the hard clips\n) print
} if
/PsSoft PassSoft PsSoftOK and PassKeep length 0 gt and def

/PsNames [ /sky /cloud /rock /snow /forest /water /sand /grass ] def
/PsPal <000000 ffffff d62728 66e0ff 2ca02c 1f4fd8 f2c84b a6d854> def
/PsW 8 array def

/PsMatI -1 def
0 1 7 { dup PsNames exch get PassMat eq { /PsMatI exch def } { pop } ifelse } for
Pass /matte eq PsMatI 0 lt and {
    (fc_passes: PassMat must be one of sky cloud rock snow forest water sand grass; showing rock\n) print
    /PsMatI 2 def
} if
[ /beauty /mask /depth /material /matte ] { Pass eq } forall or or or or not {
    (fc_passes: unknown Pass ) print Pass 20 string cvs print (; showing the beauty\n) print
    /Pass /beauty store
} if
Pass /material eq { /AA false store } if          % an average of IDs is no ID

/PsFar DepthFar null eq { TMax } { DepthFar } ifelse def

% --- what the pixel hit ---------------------------------------------------------
% - -> -: PsW gets the eight shares, after fc-landscape-pixel (FcKey, Tr,
% and whatever the hit and surface set)
/fc-pass-weights {
    0 1 7 { PsW exch 0 put } for
    FcKey 0 lt { PsW 0 Tr put } {
        /AqWet where { pop AqWet } { false } ifelse { PsW 5 Tr put } {
            TreesOn { FsMat 1 eq } { false } ifelse { PsW 4 Tr put } {
                % top down, as the hooks paint them: sand, fc_trees' needle
                % litter, far canopy and grass, then snow over the painted
                % forest over rock (fc_terrain)
                /PsS 1 1 XcMw 0 fc-max sub 1 OcSd 0 fc-max sub mul sub def
                /PsR 1 PsS sub def
                /PsC PsR Ftn 2.5 mul 0 fc-max 1 fc-min mul def   % litter
                /PsR PsR PsC sub def
                PsR Ftc 0 fc-max 1 fc-min mul PsC add /PsC exch def   % + canopy
                /PsR 1 PsS sub PsC sub def
                /PsG PsR Ftg 0 fc-max 1 fc-min mul def          % grass
                /PsR PsR PsG sub def
                /PsSn Ksnow PsR mul def
                /PsFo Kfor 1 Ksnow sub mul PsR mul PsC add def
                PsW 7 PsG Tr mul put
                PsW 6 PsS Tr mul put
                PsW 3 PsSn Tr mul put
                PsW 4 PsFo Tr mul put
                PsW 2 PsR PsSn sub Kfor 1 Ksnow sub mul PsR mul sub 0 fc-max Tr mul put
            } ifelse
        } ifelse
    } ifelse
    PsW 1 1 Tr sub put
} bind def

% - -> id: the material with the largest share
/fc-pass-id {
    /PsId 0 def /PsBest -1 def
    0 1 7 { /PsK exch def
        PsW PsK get PsBest gt { /PsBest PsW PsK get def /PsId PsK def } if
    } for
    PsId
} bind def

/fc-pass-depth {                                 % - -> 0..1
    FcKey 0 lt { 0 } { 1 PsT PsFar div sub 0 fc-max 1 fc-min } ifelse
} bind def

% --- the pixel ------------------------------------------------------------------
% the cheap one, for /mask and /depth: the hit (and the clouds), no shading
/fc-pass-fast {                                  % u v -> r g b
    /FcKey -1 def                                % fc_render resets it for the centre sample only
    fc-ray /Mz exch def /My exch def /Mx exch def
    /CvB Mx dup mul Mz dup mul add CvA mul def
    Mx Mz fc-haze-colour
    fc-landscape-hit dup 0 gt { dup /PsT exch def /FcKey exch def } { pop } ifelse
    Pass /mask eq {
        FcKey 0 lt { MaskClouds { /LnT TMax store TMax fc-clouds 1 Tr sub } { 0 } ifelse } { 1 } ifelse
    } { fc-pass-depth } ifelse
    dup dup
} bind def

% the full one: the picture, then the shares, the record and the pass
/fc-pass-pixel {                                 % u v -> r g b
    /PsV exch def /PsU exch def
    /FcKey -1 def
    % what the shading leaves behind is read afterwards; zero it first, as
    % not every surface sets it (fc_coast's and fc_ocean's sand, fc_trees'
    % far canopy, and fc_terrain's snow and forest, for a piece's own surface)
    /XcMw 0 store /OcSd 0 store /Ftc 0 store /Ftg 0 store /Ftn 0 store
    /Ksnow 0 store /Kfor 0 store
    PsU PsV fc-landscape-pixel
    /PsT LnT def                                 % the hit distance (FcKey may be scaled)
    fc-pass-weights
    PsKeepOn {
        PsSoft { fc-pass-soft } if
        PsU FrU eq PsV FrV eq and { fc-pass-record } if
    } if
    Pass /beauty ne {
        PsKeepD /beauty known PsU FrU eq PsV FrV eq and and { fc-pass-keep-rgb } if
        pop pop pop
        Pass /mask eq { MaskClouds { 1 PsW 0 get sub } { FcKey 0 lt { 0 } { 1 } ifelse } ifelse dup dup } if
        Pass /depth eq { fc-pass-depth dup dup } if
        Pass /matte eq { PsW PsMatI get dup dup } if
        Pass /material eq { fc-pass-id 3 mul /PsK exch def
            PsPal PsK get 255 div PsPal PsK 1 add get 255 div PsPal PsK 2 add get 255 div } if
    } if
} bind def

% --- recording --------------------------------------------------------------------
/PsKeepOn PassKeep length 0 gt def
/PsKeepD 8 dict def
/PsFresh true def

/fc-pass-alloc {                                 % - -> -: rows for this render
    PassKeep { /PsK exch def
        PsKeepD PsK [ IH { IW PsK /beauty eq { 3 mul } if string } repeat ] put
    } forall
    PsSoft {                                     % the soft composite's own rows
        PsKeepD /mask known not { PsKeepD /mask [ IH { IW string } repeat ] put } if
        PsKeepD /alpha [ IH { IW string } repeat ] put   % the mask, raised where fg needs it
        PsKeepD /fg [ IH { IW 3 mul string } repeat ] put
        PsKeepD /bg [ IH { IW 3 mul string } repeat ] put
        /PsZr IW 7 add 8 idiv string def
    } if
    /PsLv null def
    /PsFresh false def
} bind def

/fc-pass-record {                                % - -> -: this pixel (FrI, FrJ)
    PsFresh { fc-pass-alloc } if
    PsKeepD /mask known PsSoft not and {
        PsKeepD /mask get FrJ get FrI
        MaskClouds { 1 PsW 0 get sub } { FcKey 0 lt { 0 } { 1 } ifelse } ifelse fc-byte put
    } if
    PsKeepD /depth known { PsKeepD /depth get FrJ get FrI fc-pass-depth fc-byte put } if
    PsKeepD /material known { PsKeepD /material get FrJ get FrI fc-pass-id put } if
} bind def

% --- the soft composite's record (PassSoft) ---------------------------------------
% Every sample of the pixel, the centre and its antialiasing samples, adds to
% three running sums, rewritten after each: the coverage w (1 on the
% landscape; 1 - Tr on the sky with MaskClouds, else 0), the landscape's
% own colour weighted by w (fg) and what is behind it weighted by 1 - w
% (bg). Both are straight, not premultiplied: an edge pixel's fg is the
% mountain's colour alone, with none of the sky it was averaged with, so
% fg at alpha w over new art leaves no sky-coloured fringe, and fg at w
% over bg gives back the picture. On the sky with clouds, bg is the sky
% behind them (LnR LnG LnB, graded and toned as the picture is) and the
% clouds are the rest of the toned picture c: fg = (c - Tr bg) / (1 - Tr),
% unpremultiplied in the picture's own (toned) space, so that w fg +
% (1 - w) bg is c again; the tone curve isn't linear, so splitting before
% it would darken the clouds.
/PsAf [ 0 0 0 ] def /PsAb [ 0 0 0 ] def /PsBc [ 0 0 0 ] def
/PsFg [ 0 0 0 ] def /PsBg [ 0 0 0 ] def
/PsAn 0 def /PsAw 0 def /PsAs 0 def
/fc-pass-add-f {                                 % r g b w -> -: add w x rgb to fg
    /PsCk exch def /PsAw PsAw PsCk add def
    2 -1 0 { /PsCq exch def PsCk mul PsAf PsCq get add PsAf PsCq 3 -1 roll put } for
} bind def
/fc-pass-add-b {                                 % r g b w -> -: ... and to bg
    /PsCk exch def /PsAs PsAs PsCk add def
    2 -1 0 { /PsCq exch def PsCk mul PsAb PsCq get add PsAb PsCq 3 -1 roll put } for
} bind def
/fc-pass-put3 {                                  % rows sums weight -> -: this pixel's colour
    /PsCk exch def /PsCs exch def FrJ get /PsKr exch def
    0 1 2 { /PsCq exch def PsKr FrI 3 mul PsCq add PsCs PsCq get PsCk div fc-byte put } for
} bind def
/fc-pass-soft {                                  % r g b -> r g b
    PsFresh { fc-pass-alloc } if
    PsU FrU eq PsV FrV eq and {                  % the centre sample comes first
        /PsAn 0 def /PsAw 0 def /PsAs 0 def
        0 1 2 { dup PsAf exch 0 put PsAb exch 0 put } for
    } if
    /PsAn PsAn 1 add def
    FcKey 0 ge { 3 copy 1 fc-pass-add-f } {
        MaskClouds 1 Tr sub 1e-4 gt and {
            % the sky behind the clouds b, toned; the clouds then hold
            % what is left of the toned picture c: c - Tr b, over 1 - Tr
            LnR LnG LnB fc-landscape-grade fc-tone
            PsBc 2 3 -1 roll put PsBc 1 3 -1 roll put PsBc 0 3 -1 roll put
            PsBc aload pop Tr fc-pass-add-b
            /PsAw PsAw 1 Tr sub add def
            3 copy 2 -1 0 { /PsCq exch def
                PsBc PsCq get Tr mul sub PsAf PsCq get add PsAf PsCq 3 -1 roll put
            } for
        } { 3 copy 1 fc-pass-add-b } ifelse
    } ifelse
    /PsAa PsAw PsAn div def
    PsKeepD /mask get FrJ get FrI PsAa fc-byte put
    0 1 2 { /PsCq exch def
        PsFg PsCq PsAw 0 gt { PsAf PsCq get PsAw div } { PsAb PsCq get PsAs div } ifelse put
        PsBg PsCq PsAs 0 gt { PsAb PsCq get PsAs div } { PsFg PsCq get } ifelse put
    } for
    PsAw 0 gt PsAs 0 gt and { fc-pass-fit } if
    PsKeepD /alpha get FrJ get FrI PsAa fc-byte put
    PsKeepD /fg get PsFg 1 fc-pass-put3
    PsKeepD /bg get PsBg 1 fc-pass-put3
} bind def

% - -> -: keep fg in 0..1. Over a dark sky a bright cloud's straight colour
% (c - Tr bg) / (1 - Tr) can pass 1 (the tone curve is concave), and a
% clamped fg would no longer give back the picture. Any alpha a' >= a with
% fg' = bg + a (fg - bg) / a' composites to the same colour, so raise the
% compositing alpha (PsAa, kept apart from the mask) just enough that every
% channel of fg' is in range
/fc-pass-fit {
    /PsAt PsAa def
    0 1 2 { /PsCq exch def
        /PsCf PsFg PsCq get def /PsCb PsBg PsCq get def
        PsCf 1 gt { PsCb 0.999999 lt { PsAa PsCf PsCb sub mul 1 PsCb sub div } { 1 } ifelse
                    PsAt fc-max /PsAt exch def } if
        PsCf 0 lt { PsCb 0.000001 gt { PsAa PsCb PsCf sub mul PsCb div } { 1 } ifelse
                    PsAt fc-max /PsAt exch def } if
    } for
    /PsAt PsAt 1 fc-min def
    PsAt PsAa gt {
        0 1 2 { /PsCq exch def
            PsFg PsCq PsBg PsCq get PsFg PsCq get PsBg PsCq get sub PsAa mul PsAt div add put
        } for
        /PsAa PsAt def
    } if
} bind def

% r g b -> r g b: the picture's centre sample, when the image shows a pass
/fc-pass-keep-rgb {
    PsFresh { fc-pass-alloc } if
    PsKeepD /beauty get FrJ get
    /PsKr exch def
    3 copy fc-byte PsKr FrI 3 mul 2 add 3 -1 roll put
    fc-byte PsKr FrI 3 mul 1 add 3 -1 roll put
    fc-byte PsKr FrI 3 mul 3 -1 roll put
} bind def

% fc_render.ps hands over every finished row (the antialiased picture)
/fc-render-row {                                 % row -> -
    PsKeepD /beauty known Pass /beauty eq and {
        PsFresh { fc-pass-alloc } if
        PsKeepD /beauty get FrJ get FrI0 3 mul 3 -1 roll putinterval
    } { pop } ifelse
} bind def

/PsRender0 /fc-render load def
/fc-render { /PsFresh true def PsRender0 } bind def

Pass /mask eq Pass /depth eq or PsKeepOn not and
    { /fc-pixel { fc-pass-fast } bind def }
    { /fc-pixel { fc-pass-pixel } bind def } ifelse

% --- using the kept passes ----------------------------------------------------------
/fc-landscape-keep {                             % pw ph -> -
    PsKeepOn not { (fc_passes: fc-landscape-keep with nothing in PassKeep\n) print } if
    % nulldevice paints nothing but still runs the image's data procedure;
    % keep the matrix, which it resets. Under pscat --bands fc-render reads
    % the band from defaultmatrix, which nulldevice resets too, so a band
    % (or an interpreter without nulldevice) keeps the empty clip
    gsave
    PsSoftOK /BandBBox where { pop false } { true } ifelse and
        { matrix currentmatrix nulldevice setmatrix } { newpath 0 0 0 0 rectclip } ifelse
    fc-landscape
    grestore
} bind def

/fc-pass-rows {                                  % name -> rows | null
    PsKeepD 1 index known { PsKeepD exch get } {
        (fc_passes: ) print 20 string cvs print ( was not kept (PassKeep)\n) print null
    } ifelse
} bind def

/fc-pass-draw {                                  % name -> -
    dup /PsDn exch def fc-pass-rows dup null eq { pop } {
        /PsDa exch def /PsDj 0 def
        gsave
        FrPw FrPh scale
        /PsDm [ IW 0 0 IH neg 0 IH ] def
        PsDn /beauty eq PsDn /fg eq or PsDn /bg eq or {
            IW IH 8 PsDm { PsDa PsDj get /PsDj PsDj 1 add def } false 3 colorimage
        } {
            PsDn /material eq {
                [ /Indexed /DeviceRGB 7 PsPal ] setcolorspace
                << /ImageType 1 /Width IW /Height IH /BitsPerComponent 8 /Decode [ 0 255 ]
                   /ImageMatrix PsDm /DataSource { PsDa PsDj get /PsDj PsDj 1 add def } >> image
            } {
                IW IH 8 PsDm { PsDa PsDj get /PsDj PsDj 1 add def } image
            } ifelse
        } ifelse
        grestore
    } ifelse
} bind def

% land -> -: clip to the runs of kept-mask pixels that are (land true) or
% aren't (false) at least half covered
/fc-pass-clip {
    /PsCl exch def
    /mask fc-pass-rows dup null eq { pop } {
        /PsCa exch def
        /PsSx FrPw IW div def /PsSy FrPh IH div def
        [
            0 1 IH 1 sub { /PsCj exch def
                /PsCr PsCa PsCj get def /PsC0 -1 def
                0 1 IW { /PsCi exch def
                    PsCi IW lt { PsCr PsCi get 128 ge PsCl eq } { false } ifelse {
                        PsC0 0 lt { /PsC0 PsCi def } if
                    } {
                        PsC0 0 ge {
                            PsC0 PsSx mul  IH PsCj sub 1 sub PsSy mul
                            PsCi PsC0 sub PsSx mul  PsSy
                            /PsC0 -1 def
                        } if
                    } ifelse
                } for
            } for
        ]
        dup length 0 eq { pop 0 0 0 0 } if rectclip
    } ifelse
} bind def
/fc-sky-clip { false fc-pass-clip } bind def
/fc-land-clip { true fc-pass-clip } bind def

% --- soft compositing (PassSoft, pscat 0.7) -------------------------------------
% pscat's ImageType 3 masks are 1 bit, so a soft edge is drawn as layers: the
% kept coverage is cut into PsQ levels, and the pixels at level q are painted
% once, through a 1-bit mask, at alpha q / PsQ (times the alpha in force).
% Each pixel is painted at most once, at its own alpha, so the result is
% straight-alpha "over", within 1/(2 PsQ) of the exact coverage.
/PsQ 64 def
/PsLv null def

% - -> -: PsLv[q] the 1-bit rows (or null) of the pixels at level q, between
% rows PsLj0[q] and PsLj1[q]
/fc-pass-levels {
    /PsLv PsQ 1 add array def /PsLj0 PsQ 1 add array def /PsLj1 PsQ 1 add array def
    /PsMb IW 7 add 8 idiv def
    /PsCa PsKeepD /alpha get def
    0 1 IH 1 sub { /PsCj exch def /PsCr PsCa PsCj get def
        0 1 IW 1 sub { /PsCi exch def
            PsCr PsCi get dup 0 gt {
                PsQ mul 127 add 255 idiv dup 0 gt {
                    /PsLq exch def
                    PsLv PsLq get null eq { PsLv PsLq IH array put PsLj0 PsLq PsCj put } if
                    PsLj1 PsLq PsCj put
                    PsLv PsLq get dup PsCj get null eq { dup PsCj PsMb string put } if
                    PsCj get PsCi -3 bitshift 2 copy get 128 PsCi 7 and neg bitshift or put
                } { pop } ifelse
            } { pop } ifelse
        } for
    } for
} bind def

% rows maskrows j0 j1 -> -: frame rows j0..j1 of a kept colour pass through
% 1-bit mask rows (null: none of the row), in the frame's unit square
/fc-pass-mimage {
    /PsJ1 exch def /PsJ0 exch def /PsMr exch def /PsDr exch def
    /PsDj PsJ0 def /PsMj PsJ0 def
    /DeviceRGB setcolorspace
    << /ImageType 3 /InterleaveType 3
       /DataDict << /ImageType 1 /Width IW /Height PsJ1 PsJ0 sub 1 add /BitsPerComponent 8
                    /Decode [0 1 0 1 0 1] /ImageMatrix [IW 0 0 IH neg 0 IH PsJ0 sub]
                    /DataSource { PsDr PsDj get /PsDj PsDj 1 add def } >>
       /MaskDict << /ImageType 1 /Width IW /Height PsJ1 PsJ0 sub 1 add /BitsPerComponent 1
                    /Decode [1 0] /ImageMatrix [IW 0 0 IH neg 0 IH PsJ0 sub]
                    /DataSource { PsMr PsMj get dup null eq { pop PsZr } if /PsMj PsMj 1 add def } >>
    >> image
} bind def

% - -> -: the landscape over what is on the page, its edge (and with
% MaskClouds its clouds over the sky) soft; the hard fallback is the beauty
% through fc-land-clip
/fc-land-draw {
    PsSoft {
        PsKeepD /fg known not { (fc_passes: fc-land-draw before the landscape was kept\n) print } {
            PsLv null eq { fc-pass-levels } if
            gsave
            FrPw FrPh scale
            /PsA0 currentalpha def
            1 1 PsQ { /PsLk exch def
                PsLv PsLk get null ne {
                    PsA0 PsLk mul PsQ div setalpha
                    PsKeepD /fg get PsLv PsLk get PsLj0 PsLk get PsLj1 PsLk get fc-pass-mimage
                } if
            } for
            grestore
        } ifelse
    } { gsave fc-land-clip /beauty fc-pass-draw grestore } ifelse
} bind def

% - -> -: what is behind the landscape, opaque (the sky, and clouds unless
% MaskClouds), over the whole frame; the hard fallback is the beauty
/fc-sky-draw {
    PsSoft { /bg fc-pass-draw } { /beauty fc-pass-draw } ifelse
} bind def

% proc -> -: the picture with proc's art behind the landscape: the sky, then
% the art, then the landscape with a soft edge; the hard fallback is the
% beauty, then the art through fc-sky-clip
/fc-behind {
    PsSoft { fc-sky-draw gsave exec grestore fc-land-draw }
           { /beauty fc-pass-draw gsave fc-sky-clip exec grestore } ifelse
} bind def
