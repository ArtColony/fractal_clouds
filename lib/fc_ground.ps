%!PS-Adobe-3.0
% fc_ground.ps -- foreground ground cover (fractal_clouds#29): boulders,
% stones and shrubs, grass texture, and more terrain octaves near the camera.
%
% fc_terrain.ps loads this file at its end when GroundOn is true (set it
% before loading, like every setting). It
%
%   - wraps fc-height: x z oct fc-height h now includes boulders, faceted
%     solids standing on the ground (#84), so the march, the normals and
%     the water all see them, and clamps the march's step near the ground
%     so grazing rays don't step over them;
%   - adds fc-ground-shade, which fc-terrain-shade calls after the material
%     hook: rock colour on the boulders (darker toward the foot, snow only
%     on flat tops), contact occlusion and a sun shadow beside each, stones on green ground turned into dark shrubs,
%     and a clumpy grass texture (albedo and normal) on green ground;
%   - lets fc-terrain-oct go GroundOct octaves past TerrOct (fc_terrain.ps
%     reads GroundOct), so near ground keeps getting finer instead of going
%     smooth inside about 50 units at 320 px (200 at 1280).
%
% Each layer is a jittered grid, one candidate rock per cell, kept where a
% hash of the cell is under a density that two smooth noises gather into
% patches. Every per-rock number comes from an integer hash of its cell
% (no rand: the random stream the bakes use is untouched). A stone is a
% flattened ellipsoid in the shading only; a boulder is described at
% fc-ground-boulder. Detail follows distance: a layer is skipped once
% its biggest rock is under about a pixel across, and each rock fades in
% as its radius grows from about 1 px to about 3.3 px. The grass texture
% shows only within the same near band.

/BoulderCell 2.6 fc-default          % boulder grid cell, world units (~10 m)
/BoulderDens 0.22 fc-default         % mean share of cells with a boulder
/BoulderSize 0.42 fc-default         % biggest boulder radius
/BoulderH 0.6 fc-default             % mean height above the ground at its centre / radius
/StoneCell 0.55 fc-default           % stone (and shrub) grid cell
/StoneDens 0.3 fc-default
/StoneSize 0.11 fc-default
/GroundRough 0.12 fc-default         % rough near ground: height per unit of wavelength (0: none)
/GroundFar 0.6 fc-default            % two-pixel footprint (units) beyond which the ground isn't roughened (full at a third of it)
/GroundPatch 0.5 fc-default          % 0..1: how strongly rocks gather in patches
/GrassAmp 1 fc-default               % strength of the grass texture (0: none)
/GrassDry [ 0.56 0.52 0.33 ] fc-colour   % sRGB: sun-dried grass in patches
/ShrubCol [ 0.17 0.22 0.13 ] fc-colour   % sRGB: shrubs (stones on green ground)
/GroundNear 0.35 fc-default          % two-pixel footprint (units) under which grass texture starts

% i j k -> h: a 31-bit hash of a cell (one xorshift, two multiply rounds)
/fc-ground-hash {
    1013904223 mul exch 668265263 mul add exch 374761393 mul add
    16#7fffffff and dup -13 bitshift xor
    16#45D9F3B mul 16#7fffffff and dup -16 bitshift xor
    16#45D9F3B mul 16#7fffffff and dup -15 bitshift xor
} bind def

% oct -> two-pixel footprint, world units (inverse of fc-terrain-oct)
/fc-ground-foot { 2 exch exp TerrScale mul 1 exch div } bind def

% x z cell dens size k -> h: one rock layer at x z; leaves GnD2 (the
% point's squared distance from its cell's rock, in radii; 9 if none),
% GnR (that rock's radius), GnRx GnRz (its centre), GnT (a 0..1 tone) and
% GnW (its distance fade). Reads GnF, the two-pixel footprint.
/fc-ground-layer {
    /GnK exch def /GnS exch def /GnP exch def /GnC exch def /GnZ exch def /GnX exch def
    /GnD2 9 def /GnR 0 def /GnW 0 def
    GnF GnS 2 mul lt {
        GnX GnC div floor cvi /GnI exch def  GnZ GnC div floor cvi /GnJ exch def
        GnI GnJ GnK fc-ground-hash /GnQ exch def
        GnQ 255 and 255 div GnP 2 mul lt {
        % rocks gather in patches, with open ground between
        GroundPatch 0 gt {
            GnX 0.035 mul 17.3 add GnK add GnZ 0.035 mul 5.1 add fc-noise2 0.65 mul
            GnX 0.13 mul 2.9 add GnZ 0.13 mul 11.7 add GnK add fc-noise2 0.35 mul add
            0.5 GroundPatch 0.25 mul sub  0.5 GroundPatch 0.25 mul add  3 -1 roll fc-smooth
            GroundPatch mul 1 GroundPatch sub 0.5 mul add
        } { 0.5 } ifelse 2 mul GnP mul
        GnQ 255 and 255 div gt {
            % many small rocks, few big ones
            /GnR GnQ -23 bitshift 255 and 255 div dup mul 0.65 mul 0.35 add GnS mul def
            % fade in as the radius grows from 1 px (2 R = GnF) to 3.3 px (0.6 R = GnF)
            /GnW GnR 2 mul GnR 0.6 mul GnF fc-smooth def
            GnW 0 gt {
                GnI GnJ GnK 7 add fc-ground-hash /GnQ2 exch def
                /GnT GnQ2 -23 bitshift 255 and 255 div def
                % the centre, jittered as far as the rock still fits its cell
                1 GnR 3.2 mul GnC div sub 0 fc-max /GnJit exch def
                /GnRx GnI 0.5 add GnQ -8 bitshift 255 and 255 div 0.5 sub GnJit mul add GnC mul def
                /GnRz GnJ 0.5 add GnQ -16 bitshift 255 and 255 div 0.5 sub GnJit mul add GnC mul def
                /GnDx GnX GnRx sub def /GnDz GnZ GnRz sub def
                % elongated up to 1.3 : 0.7, turned its own way
                /GnA GnQ2 255 and 255 div 180 mul def
                /GnE GnQ2 -8 bitshift 255 and 255 div 0.3 mul def
                /GnAc GnA cos def /GnAs GnA sin def
                GnDx GnAc mul GnDz GnAs mul add GnR 1 GnE add mul div dup mul
                GnDz GnAc mul GnDx GnAs mul sub GnR 1 GnE sub mul div dup mul add
                % a lumpy outline and top
                GnDx GnR div 1.1 mul GnT 37 mul add GnDz GnR div 1.1 mul GnI 0.37 mul add fc-noise2
                0.5 sub 0.7 mul 1 add mul /GnD2 exch def
                GnD2 0.9375 lt {
                    % partly buried: the top of an ellipsoid above a quarter of its height
                    1 GnD2 sub sqrt 0.25 sub 0.75 div
                    GnQ2 -16 bitshift 255 and 255 div 0.6 mul 0.7 add BoulderH mul GnR mul mul
                    GnW mul
                } { 0 } ifelse
            } { 0 } ifelse
        } { 0 } ifelse
        } { 0 } ifelse
    } { 0 } ifelse
} bind def

% Boulders (#84) are solids standing on the ground, not bumps added to
% it: each has an absolute top, its own ground height at its centre (the
% plain terrain at TerrOct, so the rock is the same at every distance)
% plus a faceted profile, and the surface is the higher of the ground and
% that top. On a slope a boulder is buried on its uphill side and stands
% proud on its downhill side, and it meets the ground in a real contact
% line. The profile is the lowest of a tilted top face and six side faces
% at hashed angles, slopes and distances (an irregular, angular outline),
% with two octaves of displacement once they span a few pixels. Faces
% carry on down past the outline, so a downhill face reaches the ground
% instead of ending in a ledge.

% (cache of the last rock centre's ground height: the normals and the
% sun probes ask for the same rock again and again)
/GnCi -2147483647 def /GnCj -2147483647 def /GnCh 0 def /GnCg 0 def
% -> h: the plain ground at the rock centre GnRx GnRz (cell GbI GbJ);
% leaves GnCg, the ground's slope there (rise per unit run, from the
% heights a radius away along x and z)
/fc-ground-hc {
    GbI GnCi eq GbJ GnCj eq and not {
        GnRx GnRz TerrOct fc-height-base /GnCh exch def
        GnRx GnR add GnRz TerrOct fc-height-base GnCh sub
        GnRx GnRz GnR add TerrOct fc-height-base GnCh sub
        dup mul exch dup mul add sqrt GnR div /GnCg exch def
        /GnCi GbI def /GnCj GbJ def
    } if
    GnCh
} bind def

% x z -> top: the boulder of the cell under x z, as an absolute height
% (-1e9 where there is none). Reads GnF, the two-pixel footprint. Leaves
% GnR (radius), GnRx GnRz (centre), GnDx GnDz (offset from it), GnT (a
% 0..1 tone), GnW (distance fade), GnBH (height scale) and GnBr2 (squared
% distance from the centre, in radii, in the rock's own stretched frame;
% 9 if no rock).
/GnR 0 def /GnW 0 def /GnT 0 def /GnBH 1 def /GnBr2 9 def
/GnRx 0 def /GnRz 0 def /GnDx 0 def /GnDz 0 def
/fc-ground-boulder {
    /GbZ exch def /GbX exch def
    /GnW 0 def /GnR 0 def /GnBr2 9 def
    -1e9
    GnF BoulderSize 2 mul lt {
        GbX BoulderCell div floor cvi /GbI exch def  GbZ BoulderCell div floor cvi /GbJ exch def
        GbI GbJ 0 fc-ground-hash /GbQ exch def
        GbQ 255 and 255 div BoulderDens 2 mul lt {
        % rocks gather in patches, with open ground between
        GroundPatch 0 gt {
            GbX 0.035 mul 17.3 add GbZ 0.035 mul 5.1 add fc-noise2 0.65 mul
            GbX 0.13 mul 2.9 add GbZ 0.13 mul 11.7 add fc-noise2 0.35 mul add
            0.5 GroundPatch 0.25 mul sub  0.5 GroundPatch 0.25 mul add  3 -1 roll fc-smooth
            GroundPatch mul 1 GroundPatch sub 0.5 mul add
        } { 0.5 } ifelse 2 mul BoulderDens mul
        GbQ 255 and 255 div gt {
            % many small rocks, few big ones
            /GnR GbQ -23 bitshift 255 and 255 div dup mul 0.65 mul 0.35 add BoulderSize mul def
            % fade in as the radius grows from 1 px (2 R = GnF) to 3.3 px (0.6 R = GnF)
            /GnW GnR 2 mul GnR 0.6 mul GnF fc-smooth def
            GnW 0 gt {
                GbI GbJ 7 fc-ground-hash /GbQ2 exch def
                GbI GbJ 13 fc-ground-hash /GbQ3 exch def
                /GnT GbQ2 -23 bitshift 255 and 255 div def
                % the centre, jittered as far as the whole rock (1.6
                % radii, stretched 1.3) still fits its cell
                1 GnR 4.2 mul BoulderCell div sub 0 fc-max /GbJit exch def
                /GnRx GbI 0.5 add GbQ -8 bitshift 255 and 255 div 0.5 sub GbJit mul add BoulderCell mul def
                /GnRz GbJ 0.5 add GbQ -16 bitshift 255 and 255 div 0.5 sub GbJit mul add BoulderCell mul def
                /GnDx GbX GnRx sub def /GnDz GbZ GnRz sub def
                % elongated up to 1.3 : 0.7, turned its own way
                /GbA GbQ2 255 and 255 div 180 mul def
                /GbE GbQ2 -8 bitshift 255 and 255 div 0.3 mul def
                /GbAc GbA cos def /GbAs GbA sin def
                /GbU GnDx GbAc mul GnDz GbAs mul add GnR 1 GbE add mul div def
                /GbV GnDz GbAc mul GnDx GbAs mul sub GnR 1 GbE sub mul div def
                /GnBr2 GbU dup mul GbV dup mul add def
                /GnBH GnR BoulderH mul 0.75 div GbQ3 -16 bitshift 255 and 255 div 0.5 mul 0.75 add mul def
                GnBr2 2.56 lt {
                    pop
                    % the top face, tilted up to 0.15 each way
                    1 GbU GbQ3 255 and 255 div 0.5 sub 0.3 mul mul add
                      GbV GbQ3 -8 bitshift 255 and 255 div 0.5 sub 0.3 mul mul add
                    % six side faces, about 60 degrees apart: slope 1.3..2.5 (heights
                    % per radius), reaching the base level 0.8..1.15 radii out
                    /GbA0 GbQ3 -24 bitshift 127 and 127 div 60 mul def
                    0 1 5 { /GbK exch def
                        GbI GbJ GbK 20 add fc-ground-hash /GbH exch def
                        GbK 60 mul GbA0 add GbH 255 and 255 div 0.5 sub 34 mul add /GbTh exch def
                        GbH -16 bitshift 255 and 255 div 0.35 mul 0.8 add
                        GbU GbTh cos mul GbV GbTh sin mul add sub
                        GbH -8 bitshift 255 and 255 div 1.2 mul 1.3 add mul
                        fc-min
                    } for
                    % displacement: lumps on the faces and the outline, each
                    % octave once its wavelength spans 2.5 footprints
                    GbU 1.6 mul GnT 37 mul add GbV 1.6 mul GbI 0.37 mul add fc-noise2 0.5 sub 0.3 mul
                    1.25 3 GnR 1.6 div GnF div fc-smooth mul add
                    GbU 4.1 mul GbJ 0.29 mul add GbV 4.1 mul GnT 19 mul add fc-noise2 0.5 sub 0.14 mul
                    1.25 3 GnR 4.1 div GnF div fc-smooth mul add
                    % a quarter of the height buried; the faces sink out of
                    % reach toward 1.6 radii
                    % a quarter of the height buried, less on a slope (where
                    % the uphill side buries it anyway)
                    0.25 sub GnBH mul fc-ground-hc add GnCg 0.35 mul GnR mul add
                    1.44 2.56 GnBr2 fc-smooth GnBH 4 mul mul sub
                    % none rest on ground steeper than about 40 degrees
                    % (and a face never runs away down a slope steeper than it)
                    /GnW GnW 1 0.65 0.9 GnCg fc-smooth sub mul def
                } if
            } if
        } if
        } if
    } if
} bind def

% -> h: rough ground at GnPx GnPz, octaves of value noise from about a
% metre down, each amplitude in proportion to its wavelength, each in its
% own turned frame (so none tiles), each only once it spans 2.5 footprints
/GnRoughOcts [ 1.3 0  0.55 41  0.23 83  0.1 127  0.042 19 ] def
% each octave's turn as cos, sin (index: octave pair / 2)
/GnRoughC [ 0 2 GnRoughOcts length 2 sub { GnRoughOcts exch 1 add get cos } for ] def
/GnRoughS [ 0 2 GnRoughOcts length 2 sub { GnRoughOcts exch 1 add get sin } for ] def
/fc-ground-rough {
    0
    0 2 GnRoughOcts length 2 sub { /GnOi exch def
        GnRoughOcts GnOi get /GnWl exch def
        GnWl GnF div 1 gt {
            /GnOc GnRoughC GnOi 2 idiv get def /GnOs GnRoughS GnOi 2 idiv get def
            GnPx GnOc mul GnPz GnOs mul add GnWl div GnOi 3.7 mul add
            GnPz GnOc mul GnPx GnOs mul sub GnWl div 9.1 add fc-noise2
            0.5 sub GnWl mul GroundRough mul 2 mul
            1 2.5 GnWl GnF div fc-smooth mul add
        } if
    } for
    % only on the near ground: rough mid-distance slopes would shed the
    % snow there, and the look would change with the image size
    GroundFar GroundFar 0.33 mul GnF fc-smooth mul
} bind def

% below this many octaves the footprint is over twice the biggest boulder
% and over GroundFar, and nothing shows: skip the layer without the exp
/GnOctMin 1 BoulderSize 2 mul GroundFar 2 copy lt { exch } if pop TerrScale mul div ln 2 ln div def
% what the last fc-height call leaves for the step clamp: the bare ground
% there and whether rocks can show there
/GnHq 0 def /GnNear false def /GnF 1 def
/fc-height-base /fc-height load def
/fc-height {                                     % x z oct -> h
    dup GnOctMin gt {
        /GnHo exch def /GnPz exch def /GnPx exch def
        GnHo fc-ground-foot /GnF exch def
        % the rock first: the query's own fc-height-base comes last, so
        % what it leaves (the snow fill, the coast's clearances) is the query's
        % (nothing at the camera's own probe, 0 0)
        GnPx 0 eq GnPz 0 eq and { -1e9 /GnW 0 def } { GnPx GnPz fc-ground-boulder } ifelse
        GnPx GnPz GnHo fc-height-base
        GroundRough 0 gt GnF GroundFar lt and GnW 0 gt GnPx 0 ne or GnPz 0 ne or and { fc-ground-rough add } if
        dup /GnHq exch def
        % the higher of the ground and the rock, the rock fading in
        exch 1 index sub 0 fc-max GnW mul add
        /GnNear true def
    } { fc-height-base dup /GnHq exch def /GnNear false def } ifelse
} bind def

% Grazing rays and small rocks: the march's shortest step near the camera
% (0.2 units) is longer than most boulders are wide, so a ray skimming the
% ground could step over one. While a ray is within the rocks' height of
% the bare ground, near enough for rocks to show, its step is at most 0.6
% of the radius of the smallest rock tall enough to reach it (and of the
% smallest that shows at all). Wraps the march's step hook, which the
% forest march calls too.
/GnBand BoulderSize BoulderH mul 1.6 mul def
/GnStepMin BoulderSize 0.12 mul def
/fc-ground-step-base /fc-terrain-step load def
/fc-terrain-step {                               % t s -> s'
    /GnQs exch def /GnQt exch def
    GnNear {
        My GnQt mul CamY add GnHq sub /GnQc exch def
        GnQc GnBand lt {
            GnQc BoulderH 1.3 mul div  BoulderSize 0.35 mul GnF 0.5 mul fc-max  fc-max
            0.6 mul GnStepMin fc-max GnQs fc-min /GnQs exch def
        } if
    } if
    GnQt GnQs fc-ground-step-base
} bind def

% the grass octaves: wavelength (units) and turn (degrees), and the turns'
% cos and sin
/GnOcts [ 0.17 0  0.06 37  0.022 79 ] def
/GnGrassC [ 0 2 GnOcts length 2 sub { GnOcts exch 1 add get cos } for ] def
/GnGrassS [ 0 2 GnOcts length 2 sub { GnOcts exch 1 add get sin } for ] def

% fc-terrain-shade's ground hook: reads Kx Kz Ko Kt Ksnow Alb, may change
% Alb and KlMul KskyMul KbMul, and leaves GnTx GnTz, a tilt that
% fc-terrain-shade adds to the normal's x and z
/fc-ground-shade {
    Ko fc-ground-foot /GnF exch def
    /GnTx 0 def /GnTz 0 def
    % greenness of what the ground is already painted (meadow, forest
    % floor, painted forest): grass texture and shrubs go there
    Alb 1 get  Alb 0 get Alb 2 get add 0.5 mul 0.0001 add div /GnG exch def
    1.04 1.3 GnG fc-smooth 1 Ksnow sub mul /GnG exch def
    % stones: dark shrubs on green ground, pebbles elsewhere
    Kx Kz StoneCell StoneDens StoneSize 3 fc-ground-layer
    GnR 0.25 mul exch fc-ground-sat 1 Ksnow sub mul /GnSw exch def
    GnSw 0 gt {
        Alb
        Rock Rock2 GnT mix3v  [ ShrubCol { GnT 0.4 mul 0.8 add mul } forall ]  GnG mix3v
        GnSw mix3v /Alb exch def
        /KbMul KbMul 1 GnSw sub mul def
        % rounded: the normal leans out from the stone's centre
        /GnTx GnDx GnR div GnSw mul 0.9 mul def
        /GnTz GnDz GnR div GnSw mul 0.9 mul def
    } if
    % boulders (#84): how far the rock stands above the bare ground here
    % (GnE: positive on the rock, negative beside it)
    Kx Kz fc-ground-boulder /GnTop exch def
    GnTop -1e8 gt {
        /GnPx Kx def /GnPz Kz def
        Kx Kz Ko fc-height-base
        GroundRough 0 gt GnF GroundFar lt and { fc-ground-rough add } if
        GnTop exch sub
    } { -1e9 } ifelse /GnE exch def
    GnE 0 gt {
        0 GnBH 0.03 mul GnE fc-smooth GnW mul /GnBw exch def
        % snow stays only on the flattest tops
        Ksnow 0.82 0.95 Ny fc-smooth mul /GnSn exch def
        % each boulder its own tone, mottled with lichen, darker toward
        % its foot and in the crevice where it meets the ground
        0 0.4 GnE GnBH div fc-smooth /GnCv exch def
        Rock Rock2 GnT mix3v
        Kx GnR div 2.3 mul 7.7 add Kz GnR div 2.3 mul 1.9 add fc-noise2 0.5 sub 0.5 mul 1 add
        GnCv 0.45 mul 0.55 add mul
        /GnM exch def [ exch { GnM mul } forall ]
        Alb exch GnBw 1 GnSn sub mul mix3v /Alb exch def
        /Ksnow Ksnow 1 GnBw sub mul GnSn GnBw mul add def
        /KskyMul KskyMul 1 1 GnCv sub 0.5 mul GnBw mul sub mul def
        /KbMul KbMul 1 GnBw 0.5 mul sub mul def
    } if
    % contact: ground close to a boulder's faces sees less sky and bounce,
    % most where it runs in under them, a little out to 1.6 radii
    GnE 0 le GnW 0 gt and {
        1 0 0.6 GnE neg GnBH div fc-smooth sub 0.6 mul
        1 1 2.6 GnBr2 fc-smooth sub 0.2 mul fc-max GnW mul
        1 exch sub
        dup KskyMul mul /KskyMul exch def dup KbMul mul /KbMul exch def
        0.3 mul 0.7 add /GnM exch def /Alb [ Alb { GnM mul } forall ] def
    } if
    % and the boulders' sun shadows: is a boulder above the sun ray at
    % four points toward the sun, out to the longest shadow one can cast?
    GnE GnBH 0.03 mul le SunDir 1 get 0.02 gt and {        % (rock-free cells too)
        SunDir 0 get dup mul SunDir 2 get dup mul add sqrt 0.0001 fc-max /GnSh exch def
        /GnStan SunDir 1 get GnSh div def
        BoulderSize BoulderH mul 1.6 mul GnStan div BoulderSize 2.5 mul fc-min /GnSL exch def
        /GnSs 1 def
        [ 0.12 0.3 0.55 0.85 ] { GnSL mul /GnSd exch def
            Kx SunDir 0 get GnSh div GnSd mul add  Kz SunDir 2 get GnSh div GnSd mul add
            fc-ground-boulder
            Kh GnSd GnStan mul add sub BoulderSize 0.05 mul div
            0 1 3 -1 roll fc-smooth GnW mul 1 exch sub GnSs fc-min /GnSs exch def
        } forall
        /KlMul KlMul GnSs mul def
    } if
    % grass: clumps at three scales, each only once it spans a few pixels,
    % in a near band, with sun-dried patches and a clumpy normal
    GrassAmp 0 gt GnG 0 gt and GnF GroundNear lt and {
        GroundNear GroundNear 0.55 mul GnF fc-smooth GnG mul GrassAmp mul /GnGw exch def
        Alb GrassDry
        Kx 0.21 mul 4.3 add Kz 0.21 mul 9.7 add fc-noise2 0.6 mul
        Kx 0.9 mul 1.7 add Kz 0.9 mul 3.1 add fc-noise2 0.4 mul add
        0.45 0.75 3 -1 roll fc-smooth 0.6 mul GnGw mul mix3v
        /GnTone 1 def /GnBx 0 def /GnBz 0 def
        % (fc-noise2 repeats every 64 lattice cells: each octave is turned
        % its own way and shifted by the coarser ones, so the fine ones,
        % which repeat within a few units, never line up into a tiling)
        /GnWu 0 def /GnWv 0 def
        0 2 4 { /GnOi exch def
            GnOcts GnOi get /GnWl exch def
            /GnOc GnGrassC GnOi 2 idiv get def /GnOs GnGrassS GnOi 2 idiv get def
            1 2.5 GnWl GnF div fc-smooth GnGw mul /GnOw exch def
            GnOw 0 gt {
                Kx GnOc mul Kz GnOs mul add GnWl div GnWu add GnOi 2.1 mul add
                Kz GnOc mul Kx GnOs mul sub GnWl div GnWv add 5.3 add fc-noise2d
                % (the gradient is in the turned frame: turn it back)
                /GnGz exch def /GnGx exch def
                GnGx GnOc mul GnGz GnOs mul sub GnOw 0.08 mul mul GnBx add /GnBx exch def
                GnGz GnOc mul GnGx GnOs mul add GnOw 0.08 mul mul GnBz add /GnBz exch def
                dup 0.5 sub 0.55 mul GnOw mul GnTone add /GnTone exch def
                dup 7.1 mul GnWu add /GnWu exch def 4.3 mul GnWv add /GnWv exch def
            } if
        } for
        [ exch { GnTone mul } forall ] /Alb exch def
        /GnTx GnTx GnBx sub def /GnTz GnTz GnBz sub def
        /KbMul KbMul 1 GnGw sub mul def
    } if
} bind def

% a h -> 0..1: a ramp from 0 at height 0 to 1 at height a
/fc-ground-sat { exch 0.0001 fc-max div 0 fc-max 1 fc-min } bind def
